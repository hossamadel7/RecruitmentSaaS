@using RecruitmentSaaS.Models.Entities
@model IEnumerable<User>
@{ ViewData["OwnSuccessAlert"] = true; ViewData["OwnErrorAlert"] = true; } @* this page shows its own TempData alerts; _Layout skips them *@
@{
    ViewData["Title"] = "المستخدمون";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string? q = ViewBag.Q;
    int? role = ViewBag.Role;
    string status = ViewBag.Status ?? "active";
    string? team = ViewBag.Team;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int inactiveCount = ViewBag.InactiveCount ?? 0;
    bool anyFilter = !string.IsNullOrWhiteSpace(q) || role.HasValue || status != "active" || !string.IsNullOrEmpty(team);
    var managers = ViewBag.Managers as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var allTeleSales = ViewBag.AllTeleSales as List<RecruitmentSaaS.Models.Entities.User> ?? new List<RecruitmentSaaS.Models.Entities.User>();

    string[] roleNames = { "", "مدير", "استقبال", "تيلي سيلز", "محاسب", "عمليات", "مبيعات مكتبية", "مدير فريق", "مدير التيلي سيلز" };
    string[] roleColors = { "", "#dc2626", "#0ea5e9", "#8b5cf6", "#16a34a", "#f59e0b", "#6366f1", "#7c3aed", "#be185d" };
}

<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);">👤</div>
        <div>
            <h1 class="page-title">المستخدمون</h1>
            <p style="color:var(--text-muted);font-size:.8rem;margin:2px 0 0;">@Model.Count() مستخدم@(status == "active" ? " نشط" : status == "inactive" ? " معطّل" : "")</p>
        </div>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="bi bi-plus-lg me-1"></i> مستخدم جديد
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mb-4" data-auto-dismiss="4000">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-4" data-auto-dismiss="4000">❌ @TempData["Error"]</div>
}

@* Filters *@
<div class="card mb-4 users-filter-card">
    <div class="card-body">
        <form method="get" action="/Admin/Users" class="row g-2 align-items-end" id="usersFilter">
            <div class="col-12 col-md-3">
                <label class="form-label form-label-sm">بحث</label>
                <input name="q" value="@q" class="form-control form-control-sm" placeholder="اسم أو بريد إلكتروني..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm">الحالة</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="active" selected="@(status == "active")">النشطين (@activeCount)</option>
                    <option value="inactive" selected="@(status == "inactive")">المعطّلين (@inactiveCount)</option>
                    <option value="all" selected="@(status == "all")">الكل (@(activeCount + inactiveCount))</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm">الفريق</label>
                <select name="team" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">كل الفرق</option>
                    @foreach (var m in managers)
                    {
                        string mid = m.Id.ToString();
                        <option value="@mid" selected="@(team == mid)">فريق @m.FullName</option>
                    }
                    <option value="none" selected="@(team == "none")">تيلي سيلز بدون فريق</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label form-label-sm">الدور</label>
                <select name="role" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">كل الأدوار</option>
                    @for (int i = 1; i < roleNames.Length; i++)
                    {
                        if (i == (role ?? 0))
                        {
                            <option value="@i" selected="selected">@roleNames[i]</option>
                        }
                        else
                        {
                            <option value="@i">@roleNames[i]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">بحث</button>
                @if (anyFilter)
                {
                    <a href="/Admin/Users" class="btn btn-outline-secondary btn-sm flex-fill">مسح</a>
                }
            </div>
        </form>
    </div>
</div>

@* Users table *@
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state" style="padding:48px;">
                <div class="empty-state-icon">👤</div>
                <div class="empty-state-title">لا يوجد مستخدمون</div>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 users-table">
                <thead>
                    <tr>
                        <th>المستخدم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الدور</th>
                        <th>المدير / الفريق</th>
                        <th>الحالة</th>
                        <th>تاريخ الإنشاء</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        int r = u.Role;
                        string rName = r >= 1 && r < roleNames.Length ? roleNames[r] : $"دور {r}";
                        string rColor = r >= 1 && r < roleColors.Length ? roleColors[r] : "#64748b";
                        string rColorBg = rColor + "20";
                        string rColorBorder = rColor + "40";

                        // Count team members for managers (Role 7)
                        int teamCount = u.Role == 7
                        ? allTeleSales.Count(x => x.ManagerId == u.Id)
                        : 0;

                        <tr class="@(!u.IsActive ? "u-inactive" : "")">
                            <td class="u-user">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar avatar-sm"
                                         style="background:@rColorBg;color:@rColor;border:1.5px solid @rColorBorder;">
                                        @(u.FullName.FirstOrDefault())
                                    </div>
                                    <div>
                                        <div style="font-weight:600;">@u.FullName</div>
                                        @if (!string.IsNullOrWhiteSpace(u.FullNameAr))
                                        {
                                            <div style="font-size:.76rem;color:var(--text-muted)">@u.FullNameAr</div>
                                        }
                                        else if (u.Role == 3 || u.Role == 6 || u.Role == 8)
                                        {
                                            <div style="font-size:.72rem;color:#d97706"><i class="bi bi-exclamation-circle"></i> بدون اسم عربي</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="u-email" dir="ltr">@u.Email</td>
                            <td class="u-role">
                                <span style="background:@rColorBg;color:@rColor;border:1px solid @rColorBorder;
                                             font-size:.72rem;padding:3px 10px;border-radius:99px;font-weight:700;">
                                    @rName
                                </span>
                            </td>

                            @* Manager / Team column *@
                            <td class="u-team">
                                @if (u.Role == 7)
                                {
                                    @* Manager row: show team count + manage button *@
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="background:#f3e8ff;color:#7c3aed;border:1px solid #e9d5ff;
                                                     font-size:.7rem;padding:2px 8px;border-radius:99px;font-weight:700;">
                                            @teamCount موظف
                                        </span>
                                        <button class="btn btn-sm"
                                                style="background:#7c3aed;color:#fff;font-size:.72rem;padding:3px 10px;border-radius:8px;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#manageTeamModal_@u.Id"
                                                title="إدارة فريق @u.FullName">
                                            <i class="bi bi-people-fill"></i> إدارة الفريق
                                        </button>
                                    </div>
                                }
                                else if (u.Role == 8)
                                {
                                    <span style="color:#be185d;font-size:.8rem;"><i class="bi bi-diagram-3-fill"></i> كل الفرق + عملائه</span>
                                }
                                else if (u.Role == 3)
                                {
                                    @* TeleSales row: show current manager *@
                                    @if (u.Manager != null)
                                    {
                                        <span style="color:#7c3aed;font-size:.8rem;">
                                            <i class="bi bi-person-check-fill"></i> @u.Manager.FullName
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-muted);font-size:.78rem;">غير مسند لمدير</span>
                                    }
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">—</span>
                                }
                            </td>

                            <td class="u-status">
                                @if (u.IsActive)
                                {
                                    <span style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;
                                                 font-size:.72rem;padding:3px 10px;border-radius:99px;font-weight:700;">نشط</span>
                                }
                                else
                                {
                                    <span style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;
                                                 font-size:.72rem;padding:3px 10px;border-radius:99px;font-weight:700;">معطّل</span>
                                }
                            </td>
                            <td class="u-date"><span class="u-date-label">أُنشئ </span>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="u-actions">
                                <div class="d-flex gap-1 flex-wrap">
                                    <form method="post" action="/Admin/ToggleUser" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm"
                                                title="@(u.IsActive ? "تعطيل" : "تفعيل")"
                                                onclick="return confirm('هل أنت متأكد؟')">
                                            <i class="bi @(u.IsActive ? "bi-person-slash" : "bi-person-check")"></i>
                                        </button>
                                    </form>

                                    <button class="btn btn-outline-secondary btn-sm edit-user-btn"
                                            title="تعديل الاسم والبريد"
                                            data-user-id="@u.Id" data-user-name="@u.FullName" data-user-name-ar="@u.FullNameAr" data-user-email="@u.Email" data-user-role="@u.Role">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <button class="btn btn-outline-secondary btn-sm"
                                            title="تغيير كلمة المرور"
                                            onclick="openResetPwd('@u.Id', '@u.FullName')">
                                        <i class="bi bi-key"></i>
                                    </button>

                                    @if (u.Role == 3 || u.Role == 8)
                                    {
                                        <button class="btn btn-outline-success btn-sm"
                                                title="نسخ الرابط الشخصي لـ @u.FullName"
                                                onclick="copyRefLink('@u.Id', '@u.FullName')">
                                            <i class="bi bi-link-45deg"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* ── Toast ──────────────────────────────────────────────────────────────── *@
<div id="copyToast"
     style="display:none;position:fixed;bottom:28px;left:50%;transform:translateX(-50%);
            background:#1B4FD8;color:#fff;padding:12px 28px;border-radius:12px;
            font-size:13px;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(27,79,216,.35);">
    ✅ تم نسخ الرابط
</div>

@* ── MANAGE TEAM MODAL (for Role 7 managers) ────────────────────────────── *@
@{
    var telesalesUsers = allTeleSales;
    var managers7 = Model.Where(u => u.Role == 7).OrderBy(u => u.FullName).ToList();

    async Task TeamRow(RecruitmentSaaS.Models.Entities.User ts, Guid mgrId, string group)
    {
        <div class="team-row @(ts.IsActive ? "" : "is-inactive")" data-group="@group" data-name="@ts.FullName.ToLowerInvariant() @ts.Email.ToLowerInvariant()">
            <div class="d-flex align-items-center gap-2" style="min-width:0">
                <div class="team-avatar">@ts.FullName.FirstOrDefault()</div>
                <div style="min-width:0">
                    <div class="team-name">
                        @ts.FullName
                        @if (!ts.IsActive) { <span class="team-badge-off">معطّل</span> }
                    </div>
                    <div class="team-sub">
                        @if (group == "other" && ts.Manager != null)
                        {
                            <span><i class="bi bi-people"></i> في فريق @ts.Manager.FullName</span>
                        }
                        else if (group == "free")
                        {
                            <span>غير مسند لأي فريق</span>
                        }
                        else
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill"></i> في هذا الفريق</span>
                        }
                    </div>
                </div>
            </div>
            <form method="post" action="/Admin/AssignManager" class="flex-shrink-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@ts.Id" />
                <input type="hidden" name="reopenTeam" value="@mgrId" />
                @if (group == "in")
                {
                    <input type="hidden" name="managerId" value="" />
                    <button type="submit" class="btn btn-sm team-btn-remove" onclick="return confirm('إزالة الموظف من الفريق؟')">
                        <i class="bi bi-x-circle"></i> إزالة
                    </button>
                }
                else
                {
                    <input type="hidden" name="managerId" value="@mgrId" />
                    <button type="submit" class="btn btn-sm team-btn-add"
                            @(group == "other" ? "onclick=\"return confirm('الموظف ده في فريق تاني — هيتنقل لهذا الفريق. متأكد؟')\"" : "")>
                        <i class="bi bi-plus-circle-fill"></i> @(group == "other" ? "نقل للفريق" : "إضافة للفريق")
                    </button>
                }
            </form>
        </div>
    }
}

<style>
    .users-table .u-email { font-family: monospace; font-size: .82rem; text-align: right; }
    .users-table .u-team { font-size: .82rem; }
    .users-table .u-date { font-size: .78rem; color: var(--text-muted); white-space: nowrap; }
    .users-table .u-date-label { display: none; }
    .users-table tr.u-inactive { opacity: .5; }

    /* Phones: each user becomes a card — name + status, email, role + team, then actions */
    @@media (max-width: 767.98px) {
        .page-header .btn-primary { flex: 1 1 100%; }
        .users-filter-card .card-body { padding: 12px; }
        .users-table thead { display: none; }
        .users-table, .users-table tbody { display: block; width: 100%; }
        .users-table tr { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; padding: 14px; border-bottom: 1px solid var(--border); }
        .users-table tr:last-child { border-bottom: 0; }
        .users-table td { display: block; border: 0 !important; padding: 0 !important; background: transparent !important; }
        .users-table .u-user { order: 1; flex: 1 1 0; min-width: 0; }
        .users-table .u-user .avatar { width: 40px; height: 40px; font-size: 1rem; flex-shrink: 0; }
        .users-table .u-status { order: 2; flex: 0 0 auto; align-self: flex-start; }
        .users-table .u-email { order: 3; flex: 1 1 100%; font-size: .78rem; color: var(--text-muted); word-break: break-all; text-align: left; }
        .users-table .u-role { order: 4; flex: 0 0 auto; }
        .users-table .u-team { order: 5; flex: 1 1 auto; min-width: 0; }
        .users-table .u-date { order: 6; flex: 1 1 auto; align-self: center; }
        .users-table .u-date-label { display: inline; }
        .users-table .u-actions { order: 7; flex: 1 1 100%; }
        .users-table .u-actions > div { flex-wrap: nowrap !important; gap: 6px !important; }
        .users-table .u-actions > div > .btn, .users-table .u-actions > div > form { flex: 1 1 0; }
        .users-table .u-actions .btn { width: 100%; height: 40px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.05rem; }
    }

    .team-toolbar { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
    .team-search { position: relative; }
    .team-search i { position: absolute; top: 50%; inset-inline-start: 12px; transform: translateY(-50%); color: var(--text-muted); }
    .team-search input { width: 100%; padding: 8px 36px; border: 1px solid var(--border); border-radius: 10px; font-size: .85rem; }
    .team-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .team-chip { border: 1px solid var(--border); background: #fff; color: var(--text-muted); border-radius: 99px; padding: 4px 12px; font-size: .78rem; font-weight: 600; cursor: pointer; }
    .team-chip.active { background: #f3e8ff; border-color: #d8b4fe; color: #7c3aed; }
    .team-chip .cnt { background: rgba(0,0,0,.06); border-radius: 99px; padding: 0 7px; margin-inline-start: 4px; font-size: .72rem; }
    .team-section-title { display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 700; color: var(--text-muted); margin: 16px 2px 8px; }
    .team-section-title:first-of-type { margin-top: 4px; }
    .team-section-title .cnt { background: #f1f5f9; border-radius: 99px; padding: 0 8px; font-size: .72rem; }
    .team-section-title.in { color: #16a34a; }
    .team-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; margin-bottom: 6px; background: #fff; }
    .team-row[data-group="in"] { border-color: #bbf7d0; background: #f7fef9; }
    .team-row.is-inactive { opacity: .55; }
    .team-avatar { width: 34px; height: 34px; flex-shrink: 0; border-radius: 50%; background: #8b5cf620; color: #8b5cf6; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .9rem; }
    .team-name { font-weight: 600; font-size: .88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .team-sub { font-size: .74rem; color: var(--text-muted); }
    .team-badge-off { background: #fef2f2; color: #dc2626; border-radius: 99px; padding: 0 7px; font-size: .68rem; margin-inline-start: 4px; }
    .team-btn-add { background: #7c3aed; color: #fff; border: none; font-size: .75rem; padding: 4px 12px; border-radius: 8px; }
    .team-btn-add:hover { background: #6d28d9; color: #fff; }
    .team-btn-remove { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; font-size: .75rem; padding: 4px 10px; border-radius: 8px; }
    .team-empty { text-align: center; color: var(--text-muted); padding: 24px; font-size: .85rem; }
</style>

@foreach (var mgr in managers7)
{
    var inTeam = telesalesUsers.Where(t => t.ManagerId == mgr.Id).OrderBy(t => !t.IsActive).ThenBy(t => t.FullName).ToList();
    var unassigned = telesalesUsers.Where(t => t.ManagerId == null).OrderBy(t => !t.IsActive).ThenBy(t => t.FullName).ToList();
    var inOtherTeams = telesalesUsers.Where(t => t.ManagerId != null && t.ManagerId != mgr.Id)
                                     .OrderBy(t => t.Manager?.FullName).ThenBy(t => t.FullName).ToList();

    <div class="modal fade team-modal" id="manageTeamModal_@mgr.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-people-fill" style="color:#7c3aed;margin-left:8px;"></i>
                        إدارة فريق: @mgr.FullName
                        <span style="font-size:.8rem;color:var(--text-muted);font-weight:500"> · @inTeam.Count موظف</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:16px 20px 20px;">
                    @if (!telesalesUsers.Any())
                    {
                        <div class="team-empty">لا يوجد موظفو تيلي سيلز في النظام</div>
                    }
                    else
                    {
                        <div class="team-toolbar">
                            <div class="team-search">
                                <i class="bi bi-search"></i>
                                <input type="search" class="team-search-input" placeholder="ابحث بالاسم أو البريد..." />
                            </div>
                            <div class="team-chips">
                                <button type="button" class="team-chip active" data-filter="all">الكل<span class="cnt">@telesalesUsers.Count</span></button>
                                <button type="button" class="team-chip" data-filter="in">في الفريق<span class="cnt">@inTeam.Count</span></button>
                                <button type="button" class="team-chip" data-filter="free">غير مسندين<span class="cnt">@unassigned.Count</span></button>
                                <button type="button" class="team-chip" data-filter="other">في فرق أخرى<span class="cnt">@inOtherTeams.Count</span></button>
                            </div>
                        </div>

                        <div class="team-section" data-section="in">
                            <div class="team-section-title in"><i class="bi bi-people-fill"></i> في الفريق <span class="cnt">@inTeam.Count</span></div>
                            @if (!inTeam.Any())
                            {
                                <div class="team-empty" style="padding:10px">لسه مفيش موظفين في الفريق — أضف من القائمة تحت</div>
                            }
                            @foreach (var ts in inTeam) { await TeamRow(ts, mgr.Id, "in"); }
                        </div>

                        @if (unassigned.Any())
                        {
                            <div class="team-section" data-section="free">
                                <div class="team-section-title"><i class="bi bi-person-plus"></i> غير مسندين لأي فريق <span class="cnt">@unassigned.Count</span></div>
                                @foreach (var ts in unassigned) { await TeamRow(ts, mgr.Id, "free"); }
                            </div>
                        }

                        @if (inOtherTeams.Any())
                        {
                            <div class="team-section" data-section="other">
                                <div class="team-section-title"><i class="bi bi-arrow-left-right"></i> في فرق أخرى <span class="cnt">@inOtherTeams.Count</span></div>
                                @foreach (var ts in inOtherTeams) { await TeamRow(ts, mgr.Id, "other"); }
                            </div>
                        }

                        <div class="team-empty team-no-results" style="display:none">لا توجد نتائج</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── CREATE USER MODAL ───────────────────────────────────────────────────── *@<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مستخدم جديد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/CreateUser" id="createUserForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                        <input name="fullName" class="form-control" required placeholder="مثال: Ahmed Mohamed" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم بالعربي <span style="font-size:.75rem;color:var(--text-muted)">(يظهر للعملاء في رسالة الترحيب)</span></label>
                        <input name="fullNameAr" class="form-control" maxlength="200" placeholder="مثال: أحمد محمد" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input name="email" type="email" class="form-control" required placeholder="example@domain.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                        <input name="password" type="password" class="form-control" required minlength="6" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الدور <span class="text-danger">*</span></label>
                        <select name="role" class="form-select" required id="roleSelect" onchange="toggleManagerField(this.value)">
                            @for (int i = 1; i < roleNames.Length; i++)
                            {
                                <option value="@i">@roleNames[i]</option>
                            }
                        </select>
                    </div>
                    @* Show manager dropdown only when Role = TeleSales (3) *@
                    <div class="mb-3" id="managerFieldWrapper" style="display:none;">
                        <label class="form-label">تعيين لفريق <span style="color:var(--text-muted);font-weight:400;">(اختياري)</span></label>
                        <select name="managerId" class="form-select" id="managerSelect">
                            <option value="">— بدون مدير —</option>
                            @foreach (var mgr in managers)
                            {
                                <option value="@mgr.Id">@mgr.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">إنشاء المستخدم</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── EDIT USER MODAL ─────────────────────────────────────────────────────── *@
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>تعديل بيانات المستخدم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/UpdateUser">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="editUserId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">الاسم <span class="text-danger">*</span></label>
                        <input name="fullName" id="editUserName" type="text" class="form-control" required minlength="2" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم بالعربي <span style="font-size:.75rem;color:var(--text-muted)">(يظهر للعملاء في رسالة الترحيب)</span></label>
                        <input name="fullNameAr" id="editUserNameAr" type="text" class="form-control" maxlength="200" dir="rtl" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                        <input name="email" id="editUserEmail" type="email" class="form-control" dir="ltr" required maxlength="255" />
                    </div>
                    <div id="editUserEmailNote" class="alert alert-warning py-2 px-3 mb-0" style="font-size:.8rem;display:none">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        البريد هو اسم الدخول — بعد الحفظ هيدخل المستخدم بالبريد الجديد. كلمة المرور مش هتتغير.
                    </div>
                    <div class="mt-3">
                        <label class="form-label">الدور</label>
                        <select name="role" id="editUserRole" class="form-select">
                            @for (int i = 1; i < roleNames.Length; i++)
                            {
                                <option value="@i">@roleNames[i]</option>
                            }
                        </select>
                        <div class="form-text">تغيير الدور بيطلّع المستخدم من النظام عشان يدخل تاني بالصلاحيات الجديدة.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── RESET PASSWORD MODAL ────────────────────────────────────────────────── *@
<div class="modal fade" id="resetPwdModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تغيير كلمة المرور</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/Admin/ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="resetUserId" />
                <div class="modal-body">
                    <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:16px;">
                        تغيير كلمة المرور لـ <strong id="resetUserName"></strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">كلمة المرور الجديدة <span class="text-danger">*</span></label>
                        <input name="newPassword" type="password" class="form-control" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">تغيير</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Team popup: search + group filter; reopen after add/remove ─────────
        document.querySelectorAll('.team-modal').forEach(function (modal) {
            var filter = 'all', term = '';
            function apply() {
                var any = false;
                modal.querySelectorAll('.team-section').forEach(function (section) {
                    var groupOk = filter === 'all' || section.dataset.section === filter;
                    var visible = 0;
                    section.querySelectorAll('.team-row').forEach(function (row) {
                        var show = groupOk && (!term || row.dataset.name.indexOf(term) !== -1);
                        row.style.display = show ? '' : 'none';
                        if (show) visible++;
                    });
                    var hasRows = section.querySelector('.team-row') !== null;
                    // keep the "in team" section (with its empty hint) when nothing is filtered
                    section.style.display = groupOk && (visible > 0 || (!term && !hasRows)) ? '' : 'none';
                    if (visible > 0) any = true;
                });
                var none = modal.querySelector('.team-no-results');
                if (none) none.style.display = any || (!term && filter === 'all') ? 'none' : '';
            }
            modal.querySelectorAll('.team-chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    modal.querySelectorAll('.team-chip').forEach(function (c) { c.classList.toggle('active', c === chip); });
                    filter = chip.dataset.filter;
                    apply();
                });
            });
            var search = modal.querySelector('.team-search-input');
            if (search) search.addEventListener('input', function () { term = search.value.trim().toLowerCase(); apply(); });
        });

        (function () {
            var openTeam = new URLSearchParams(location.search).get('openTeam');
            var modal = openTeam && document.getElementById('manageTeamModal_' + openTeam);
            if (modal) {
                new bootstrap.Modal(modal).show();
                history.replaceState(null, '', location.pathname); // don't reopen on refresh
            }
        })();

        // ── Edit user modal (data-* attributes, so names with quotes are safe) ─
        var editOriginalEmail = '';
        document.querySelectorAll('.edit-user-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                editOriginalEmail = btn.dataset.userEmail || '';
                document.getElementById('editUserId').value = btn.dataset.userId;
                document.getElementById('editUserName').value = btn.dataset.userName || '';
                document.getElementById('editUserNameAr').value = btn.dataset.userNameAr || '';
                document.getElementById('editUserEmail').value = editOriginalEmail;
                document.getElementById('editUserRole').value = btn.dataset.userRole || '';
                document.getElementById('editUserEmailNote').style.display = 'none';
                new bootstrap.Modal(document.getElementById('editUserModal')).show();
            });
        });
        document.getElementById('editUserEmail').addEventListener('input', function (e) {
            var changed = e.target.value.trim().toLowerCase() !== editOriginalEmail.toLowerCase();
            document.getElementById('editUserEmailNote').style.display = changed ? 'block' : 'none';
        });

        // ── Reset password modal ──────────────────────────────────────────────
        function openResetPwd(userId, userName) {
            document.getElementById('resetUserId').value         = userId;
            document.getElementById('resetUserName').textContent = userName;
            new bootstrap.Modal(document.getElementById('resetPwdModal')).show();
        }

        // ── Copy referral link ────────────────────────────────────────────────
        function copyRefLink(userId, userName) {
            var url   = window.location.origin + '/?ref=' + userId;
            var toast = document.getElementById('copyToast');
            navigator.clipboard.writeText(url).then(function () {
                toast.textContent   = '✅ تم نسخ رابط ' + userName;
                toast.style.display = 'block';
                toast.style.opacity = '1';
                setTimeout(function () {
                    toast.style.opacity = '0';
                    setTimeout(function () { toast.style.display = 'none'; }, 300);
                }, 3000);
            }).catch(function () {
                prompt('انسخ الرابط يدوياً:', url);
            });
        }

        // ── Show/hide manager field in create modal ───────────────────────────
        function toggleManagerField(roleVal) {
            var wrapper = document.getElementById('managerFieldWrapper');
            wrapper.style.display = roleVal === '3' ? 'block' : 'none';
        }
    </script>
}
