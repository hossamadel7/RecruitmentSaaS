@using RecruitmentSaaS.Controllers
@model RecruitmentSaaS.Models.Entities.LeadFormSetting
@{
    ViewData["Title"] = "إعدادات نموذج التسجيل";
    ViewData["Subtitle"] = "تحويل المتقدمين الأكبر سناً مباشرةً لمحادثة واتساب مع المبيعات";
    var teamForms = ViewBag.TeamForms as List<RecruitmentSaaS.Models.Entities.TeamLeadForm> ?? new();
    var baseUrl = ViewBag.BaseUrl as string;
    var missingArabic = ViewBag.MissingArabicNames as List<string> ?? new();
    var welcomeText = string.IsNullOrWhiteSpace(Model.WelcomeMessage)
        ? RecruitmentSaaS.Models.Entities.LeadFormSetting.DefaultWelcomeMessage
        : Model.WelcomeMessage;
}

<div style="padding:24px;max-width:1000px">

    @* Success/Error alerts are rendered by _Layout *@
    <div class="card">
        <div class="card-body p-4">
            <div style="font-size:12.5px;color:#64748B;line-height:1.8;margin-bottom:20px">
                لما المتقدم يختار سن يساوي أو أكبر من السن المحدد هنا ويبعت النموذج، هتتفتح له محادثة واتساب
                مع رقم المبيعات تلقائياً. لو رقم الواتساب فاضي، التحويل بيتوقف وكل المتقدمين يشوفوا صفحة الشكر العادية.
            </div>

            <form asp-action="LeadFormSettings" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px">السن اللي يبدأ منه التحويل لواتساب</label>
                    <select name="seniorAgeThreshold" class="form-select" style="max-width:200px">
                        @for (var a = HomeController.MinAge; a <= HomeController.MaxAge; a++)
                        {
                            <option value="@a" selected="@(a == Model.SeniorAgeThreshold)">@a سنة أو أكثر</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px">رقم واتساب المبيعات</label>
                    <input type="tel" name="salesWhatsAppNumber" class="form-control" dir="ltr" style="max-width:280px"
                           value="@Model.SalesWhatsAppNumber" placeholder="201012345678" maxlength="30" />
                    <div class="form-text">بالصيغة الدولية بكود الدولة وبدون + أو مسافات (مصر: 20 ثم الرقم بدون الصفر الأول).</div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" style="font-size:13px">الرسالة الجاهزة (اختياري)</label>
                    <textarea name="salesWhatsAppMessage" class="form-control" rows="3" maxlength="1000"
                              placeholder="@HomeController.DefaultSalesWhatsAppMessage">@Model.SalesWhatsAppMessage</textarea>
                    <div class="form-text">
                        تقدر تستخدم <code>{name}</code> و <code>{age}</code> و <code>{job}</code> وهتتبدل ببيانات المتقدم. لو سبتها فاضية هتتبعت الرسالة الافتراضية.
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> حفظ
                </button>
                <a href="/register" target="_blank" class="btn btn-outline-secondary ms-2">
                    <i class="bi bi-box-arrow-up-left me-1"></i> فتح صفحة التسجيل
                </a>
            </form>
        </div>
    </div>

    @* ── Automatic WhatsApp welcome ── *@
    <div class="card mt-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2" style="margin-bottom:4px">
                <div style="font-weight:700;font-size:15px"><i class="bi bi-whatsapp" style="color:#16a34a"></i> رسالة الترحيب التلقائية</div>
                <span class="badge @(Model.WelcomeMessageEnabled ? "bg-success" : "bg-secondary")">@(Model.WelcomeMessageEnabled ? "مفعّلة" : "غير مفعّلة")</span>
            </div>
            <div style="font-size:12.5px;color:#64748B;line-height:1.8;margin-bottom:14px">
                أول ما العميل يبدأ محادثة واتساب (بعد التسجيل أو لو كلمنا مباشرة)، الرسالة دي بتتبعت له تلقائياً
                باسم التيلي سيلز المسؤول عنه. بتتبعت مرة واحدة بس في كل محادثة.
                <br />استخدم <code>{agent}</code> لاسم التيلي سيلز بالعربي و <code>{name}</code> لاسم العميل.
            </div>

            @if (missingArabic.Any())
            {
                <div class="alert alert-warning py-2 px-3" style="font-size:12.5px">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    الموظفين دول لسه ملهمش اسم عربي، فالرسالة هتظهر باسمهم الإنجليزي:
                    <strong>@string.Join("، ", missingArabic)</strong> —
                    <a href="/Admin/Users">أضف الاسم العربي من صفحة المستخدمين</a>
                </div>
            }

            <form asp-action="UpdateWelcomeMessage" method="post">
                @Html.AntiForgeryToken()
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="welcomeEnabled" name="enabled" value="true" @(Model.WelcomeMessageEnabled ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="welcomeEnabled" style="font-size:13px">تفعيل الإرسال التلقائي</label>
                </div>
                <textarea name="message" id="welcomeMessage" class="form-control" rows="14" maxlength="4000" dir="rtl"
                          style="font-size:13.5px;line-height:1.7">@welcomeText</textarea>
                <div class="d-flex justify-content-between align-items-center mt-2 flex-wrap gap-2">
                    <span style="font-size:12px;color:#64748B">
                        معاينة باسم: <input type="text" id="previewAgent" value="فاطمة" class="form-control form-control-sm d-inline-block" style="width:120px" />
                    </span>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
                </div>
                <div style="font-size:12px;color:#64748B;margin-top:12px">المعاينة (زي ما العميل هيشوفها في واتساب):</div>
                <div id="welcomePreview" style="white-space:pre-wrap;background:#d9fdd3;border-radius:8px;padding:10px 12px;margin-top:6px;font-size:14px;line-height:1.6;max-width:460px"></div>
            </form>
        </div>
    </div>

    @* ── Automatic follow-up for leads who never wrote ── *@
    <div class="card mt-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2" style="margin-bottom:4px">
                <div style="font-weight:700;font-size:15px"><i class="bi bi-send-check" style="color:#16a34a"></i> رسالة متابعة تلقائية</div>
                <span class="badge @(Model.AutoFollowupEnabled ? "bg-success" : "bg-secondary")">@(Model.AutoFollowupEnabled ? "مفعّلة" : "غير مفعّلة")</span>
            </div>
            <div style="font-size:12.5px;color:#64748B;line-height:1.8;margin-bottom:14px">
                لو حد سجّل من الموقع وسنه @Model.SeniorAgeThreshold أو أكثر واتحوّل لواتساب لكن ما بعتش رسالة،
                بعد الوقت اللي تحدده هنا بتتبعتله رسالة البداية المعتمدة من Meta (<code>lead_followup</code>) باسم التيلي سيلز المسؤول عنه،
                والمحادثة بتظهر عند التيلي سيلز في الواتساب. بتتبعت مرة واحدة بس لكل عميل، ومش بتتبعت لعملاء أقدم من 24 ساعة
                أو اتسجلوا قبل التفعيل. <strong>كل رسالة منهم مدفوعة من Meta.</strong>
            </div>
            <form asp-action="UpdateAutoFollowup" method="post" class="d-flex flex-wrap align-items-end gap-3">
                @Html.AntiForgeryToken()
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="autoFollowupEnabled" name="enabled" value="true" @(Model.AutoFollowupEnabled ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="autoFollowupEnabled" style="font-size:13px">تفعيل</label>
                </div>
                <div>
                    <label class="form-label fw-semibold" style="font-size:13px">ابعت بعد</label>
                    @{ var delay = Model.AutoFollowupDelayMinutes > 0 ? Model.AutoFollowupDelayMinutes : RecruitmentSaaS.Models.Entities.LeadFormSetting.DefaultAutoFollowupDelayMinutes; }
                    <select name="delayMinutes" class="form-select" style="min-width:160px">
                        @foreach (var (m, label) in new[] { (2, "دقيقتين"), (5, "5 دقايق"), (15, "15 دقيقة"), (30, "30 دقيقة"), (60, "ساعة"), (120, "ساعتين"), (240, "4 ساعات"), (720, "12 ساعة") })
                        {
                            <option value="@m" selected="@(m == delay)">@label</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
            </form>
        </div>
    </div>

    @* ── Per-team forms ── *@
    <div class="card mt-4">
        <div class="card-body p-4">
            <div style="font-weight:700;font-size:15px;margin-bottom:4px">فورم لكل فريق</div>
            <div style="font-size:12.5px;color:#64748B;line-height:1.8;margin-bottom:16px">
                كل مدير تيلي سيلز ليه رابط تسجيل خاص بفريقه. السن المحدد فوق بيتطبق على كل الفرق:
                <br />• <strong>أقل من السن:</strong> الليد بيتسجل ويظهر لمدير الفريق بس (صفحة "ليدز فورم الفريق") — مش في الـ Pool.
                <br />• <strong>السن أو أكبر:</strong> الليد بيتوزع بالدور على تيلي سيلز الفريق ويتحول لواتساب الفريق.
                لو رقم الفريق فاضي بيتستخدم رقم المبيعات العام اللي فوق.
            </div>

            @if (!teamForms.Any())
            {
                <div style="font-size:13px;color:#64748B">لا يوجد مديري تيلي سيلز نشطين.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="font-size:13px">
                        <thead>
                            <tr>
                                <th>الفريق (المدير)</th>
                                <th>رابط الفورم</th>
                                <th>واتساب الفريق</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in teamForms)
                            {
                                var formId = "tf-" + f.Id.ToString("N");
                                var url = $"{baseUrl}/register/{f.Slug}";
                                <tr>
                                    <td style="font-weight:600;white-space:nowrap">@f.Manager.FullName</td>
                                    <td>
                                        <div class="input-group input-group-sm" dir="ltr" style="min-width:260px">
                                            <span class="input-group-text">/register/</span>
                                            <input type="text" name="slug" form="@formId" class="form-control" value="@f.Slug"
                                                   required maxlength="50" pattern="[a-z0-9][a-z0-9\-]{1,48}[a-z0-9]" />
                                            <button type="button" class="btn btn-outline-secondary copy-url" data-url="@url" title="نسخ الرابط">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                            <a href="@url" target="_blank" class="btn btn-outline-secondary" title="فتح">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="tel" name="whatsAppNumber" form="@formId" class="form-control form-control-sm" dir="ltr"
                                               value="@f.WhatsAppNumber" placeholder="@(Model.SalesWhatsAppNumber ?? "201012345678")" maxlength="30" style="min-width:150px" />
                                    </td>
                                    <td>
                                        <form id="@formId" asp-action="UpdateTeamLeadForm" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@f.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm">حفظ</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Live preview of the welcome message with WhatsApp formatting (*bold*)
    (function () {
        var box = document.getElementById('welcomeMessage'), agent = document.getElementById('previewAgent'), out = document.getElementById('welcomePreview');
        if (!box) return;
        function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
        function render() {
            var t = esc(box.value).split('{agent}').join(esc(agent.value || '')).split('{name}').join('أحمد');
            out.innerHTML = t.replace(/\*([^*\n]+)\*/g, '<b>$1</b>');
        }
        box.addEventListener('input', render);
        agent.addEventListener('input', render);
        render();
    })();

    document.querySelectorAll('.copy-url').forEach(function (btn) {
        btn.addEventListener('click', function () {
            navigator.clipboard.writeText(btn.dataset.url).then(function () {
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 1500);
            });
        });
    });
</script>
