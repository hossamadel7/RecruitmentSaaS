@using RecruitmentSaaS.Models.Entities
@using RecruitmentSaaS.Services
@model LeadFormSetting
@{
    ViewData["Title"] = "المساعد الآلي";
    ViewData["Subtitle"] = "بيجمع الاسم والسن والوظيفة من اللي بيكلمونا على واتساب مباشرة ويوزعهم";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var numbers = ViewBag.Numbers as List<(WhatsAppAccount Account, string? Team)> ?? new();
    var reasons = ViewBag.HandoffReasons as List<(string Reason, int Count)> ?? new();
    var greeting = string.IsNullOrWhiteSpace(Model.AiGreeting) ? LeadFormSetting.DefaultAiGreeting : Model.AiGreeting;
    var waitAfterAge = Model.AiWaitAfterAgeMinutes > 0 ? Model.AiWaitAfterAgeMinutes : LeadFormSetting.DefaultAiWaitAfterAgeMinutes;
    var waitNoAge = Model.AiWaitNoAgeHours > 0 ? Model.AiWaitNoAgeHours : LeadFormSetting.DefaultAiWaitNoAgeHours;
    var edited = AiMessages.Overrides(Model);
}

<div style="padding:24px;max-width:1000px">

    <div class="alert alert-info" style="font-size:13px">
        <i class="bi bi-info-circle-fill me-1"></i>
        مساعد مجاني بأسئلة ثابتة (من غير ذكاء اصطناعي): بيسأل الاسم ← السن ← الوظيفة، وبيفهم السن بالأرقام أو بالكلام (زي "خمسة وأربعين")،
        ولو العميل طلب يكلم موظف أو قال إنه مش مهتم بيحوّله لمسؤول الفريق.
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3"><div class="card"><div class="card-body p-3"><div style="font-size:1.5rem;font-weight:800">@ViewBag.StatTotal</div><div style="font-size:12px;color:#64748B">محادثات اتعامل معاها (30 يوم)</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body p-3"><div style="font-size:1.5rem;font-weight:800;color:#16a34a">@ViewBag.StatCompleted</div><div style="font-size:12px;color:#64748B">جمع البيانات واتوزعت</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body p-3"><div style="font-size:1.5rem;font-weight:800;color:#ea580c">@ViewBag.StatHandedOff</div><div style="font-size:12px;color:#64748B">اتحولت لمسؤول الفريق</div></div></div></div>
        <div class="col-6 col-md-3"><div class="card"><div class="card-body p-3"><div style="font-size:1.5rem;font-weight:800;color:#4f46e5">@ViewBag.StatCollecting</div><div style="font-size:12px;color:#64748B">شغال معاها دلوقتي</div></div></div></div>
    </div>

    <form asp-action="AiAssistant" method="post">
        @Html.AntiForgeryToken()

        <div class="card mb-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div style="font-weight:800;font-size:15px"><i class="bi bi-robot" style="color:#4f46e5"></i> التشغيل</div>
                    <span class="badge @(Model.AiEnabled ? (Model.AiTestMode ? "bg-warning text-dark" : "bg-success") : "bg-secondary")">
                        @(Model.AiEnabled ? (Model.AiTestMode ? "وضع التجربة" : "شغال مع العملاء") : "متوقف")
                    </span>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="aiEnabled" name="enabled" value="true" @(Model.AiEnabled ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="aiEnabled">تشغيل المساعد الآلي</label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="aiTest" name="testMode" value="true" @(Model.AiTestMode ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="aiTest">وضع التجربة — يرد بس على الأرقام دي:</label>
                </div>
                <textarea name="testNumbers" class="form-control" rows="2" dir="ltr" placeholder="201012345678, 201098765432">@Model.AiTestNumbers</textarea>
                <div class="form-text">أرقام واتساب بالصيغة الدولية، كل رقم في سطر أو بينهم فاصلة. شيل علامة وضع التجربة لما تكون جاهز للعملاء.</div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body p-4">
                <div style="font-weight:800;font-size:15px;margin-bottom:4px"><i class="bi bi-whatsapp" style="color:#16a34a"></i> الأرقام اللي المساعد يرد عليها</div>
                <div style="font-size:12.5px;color:#64748B;margin-bottom:12px">
                    الرقم بيحدد الفريق: العميل اللي بيكلم رقم فريق بيتوزع على توزيع الليدز بتاع الفريق ده.
                </div>
                @foreach (var (account, team) in numbers)
                {
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="numberIds" value="@account.Id" id="n-@account.Id" @(account.AiAssistantEnabled ? "checked" : "") />
                        <label class="form-check-label" for="n-@account.Id">
                            <strong>@account.Name</strong> <span dir="ltr" style="color:#64748B">@account.DisplayPhoneNumber</span>
                            — @(team != null ? "فريق " + team : "رقم عام (توزيع عام)")
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body p-4">
                <div style="font-weight:800;font-size:15px;margin-bottom:10px"><i class="bi bi-chat-quote"></i> أول رسالة</div>
                <textarea name="greeting" class="form-control" rows="3" maxlength="1000" dir="rtl">@greeting</textarea>
                <div class="form-text">المساعد بيبدأ بيها وبعدها يسأل: الاسم ← السن ← الوظيفة.</div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body p-4">
                <div style="font-weight:800;font-size:15px;margin-bottom:4px"><i class="bi bi-chat-dots"></i> رسايل المساعد</div>
                <div style="font-size:12.5px;color:#64748B;margin-bottom:14px">
                    عدّل أي رسالة. لو مسحت المربع وحفظت، الرسالة بترجع للنص الأصلي.
                    <span dir="rtl">@AiMessages.NamePlaceholder</span> بيتكتب مكانها الاسم الأول للعميل، و<span dir="rtl">@AiMessages.AgentPlaceholder</span> اسم التيلي سيلز.
                </div>
                @foreach (var def in AiMessages.All)
                {
                    var value = edited.TryGetValue(def.Key, out var t) && !string.IsNullOrWhiteSpace(t) ? t : def.Default;
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                            <label class="form-label fw-semibold mb-1" style="font-size:13px" for="m-@def.Key">
                                @def.Label
                                @if (edited.ContainsKey(def.Key)) { <span class="badge bg-info-subtle text-info-emphasis ms-1" style="font-size:10.5px">متعدلة</span> }
                            </label>
                            <button type="button" class="btn btn-link btn-sm p-0 ai-msg-reset" data-target="m-@def.Key" data-default="@def.Default" style="font-size:12px">رجّع الأصلي</button>
                        </div>
                        <textarea name="messages[@def.Key]" id="m-@def.Key" class="form-control" rows="2" maxlength="1000" dir="rtl">@value</textarea>
                        @if (def.Hint != null) { <div class="form-text">@def.Hint</div> }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body p-4">
                <div style="font-weight:800;font-size:15px;margin-bottom:10px"><i class="bi bi-signpost-split"></i> التوزيع والانتظار</div>
                <div style="font-size:12.5px;color:#64748B;line-height:1.9;margin-bottom:12px">
                    السن @(Model.SeniorAgeThreshold == 0 ? 45 : Model.SeniorAgeThreshold) أو أكثر ← أول تيلي سيلز عليه الدور في الفريق.
                    أي حاجة المساعد مش قادر يكملها (طلب يكلم موظف، رسايل صوتية، زعلان، مشكلة) ← مسؤول الفريق فوراً.
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="underAge" name="underAgeToRotation" value="true" @(Model.AiUnderAgeToRotation ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="underAge">الأصغر من السن كمان يروحوا على توزيع الفريق (لو مقفول: يستنوا مسؤول الفريق زي الفورم)</label>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" style="font-size:13px">قال السن ووقف يرد: يتوزع بعد (دقيقة)</label>
                        <input type="number" name="waitAfterAgeMinutes" class="form-control" min="5" max="10080" value="@waitAfterAge" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold" style="font-size:13px">ما قالش السن: يروح لمسؤول الفريق بعد (ساعة)</label>
                        <input type="number" name="waitNoAgeHours" class="form-control" min="1" max="336" value="@waitNoAge" />
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
    </form>
    <script>
        document.querySelectorAll('.ai-msg-reset').forEach(function (b) {
            b.addEventListener('click', function () { document.getElementById(b.dataset.target).value = b.dataset.default; });
        });
    </script>

    @if (reasons.Any())
    {
        <div class="card mt-4">
            <div class="card-body p-4">
                <div style="font-weight:800;font-size:15px;margin-bottom:8px">ليه اتحولت لمسؤول الفريق؟ (30 يوم)</div>
                @foreach (var (reason, count) in reasons)
                {
                    <div class="d-flex justify-content-between" style="font-size:13px;padding:4px 0;border-bottom:1px solid #f1f5f9"><span>@reason</span><strong>@count</strong></div>
                }
            </div>
        </div>
    }
</div>
