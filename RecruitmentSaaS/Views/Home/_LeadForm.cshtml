@using RecruitmentSaaS.Controllers
@{
    // Shared registration form — used by the home page and the standalone /register page.
    var returnTo = ViewData["ReturnTo"] as string ?? "home";
    var teamSlug = ViewData["TeamSlug"] as string;
    var formError = TempData["FormError"]?.ToString() ?? "";
    var logoPath = "/images/logo-fahd.webp";
}
<div class="form-split reveal-scale">

    <!-- Left: trust panel -->
    <div class="form-trust-panel">
        <div class="form-trust-logo">
            <img src="@logoPath" alt="الفهد العربي" />
        </div>
        <div class="form-trust-title">لماذا تثق فينا؟</div>
        <div class="form-trust-sub">٤ أسباب تجعل الفهد العربي خيارك الأول</div>

        <div class="form-trust-points">
            <div class="form-trust-point">
                <div class="form-trust-point-icon"><i class="bi bi-patch-check-fill"></i></div>
                <div class="form-trust-point-text">
                    <strong>مرخصة رسمياً</strong>
                    معتمدون من وزارة القوى العاملة وسفارات الدول المستقبِلة
                </div>
            </div>
            <div class="form-trust-point">
                <div class="form-trust-point-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
                <div class="form-trust-point-text">
                    <strong>عقود شفافة</strong>
                    كل حقوقك مكتوبة ومضمونة قبل السفر
                </div>
            </div>
            <div class="form-trust-point">
                <div class="form-trust-point-icon"><i class="bi bi-headset"></i></div>
                <div class="form-trust-point-text">
                    <strong>دعم ما بعد السفر</strong>
                    فريقنا معك حتى بعد وصولك واستقرارك
                </div>
            </div>
            <div class="form-trust-point">
                <div class="form-trust-point-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="form-trust-point-text">
                    <strong>الاستشارة مجانية</strong>
                    لا رسوم مسبقة — ندفع فقط عند إتمام الإجراءات
                </div>
            </div>
        </div>

        <div class="form-trust-rating">
            <div class="form-trust-stars">★★★★★</div>
            <div class="form-trust-score">٤.٩ / ٥</div>
            <div class="form-trust-count">بناءً على +٢٣٠٠ تقييم موثق</div>
        </div>
    </div>

    <!-- Right: form fields -->
    <div class="form-body" id="register-form" style="scroll-margin-top:84px">
        <div class="form-body-header">
            <h2>
                <i class="bi bi-clipboard2-check-fill me-2" style="font-size:.95rem;color:#1E3055"></i>
                نموذج التسجيل
            </h2>
            <p>جميع الحقول المُعلّمة بـ * مطلوبة — التسجيل مجاني تماماً</p>
        </div>

        @if (!string.IsNullOrEmpty(formError))
        {
            <div class="error-banner">
                <i class="bi bi-exclamation-circle-fill"></i> @formError
            </div>
        }

        <form method="post" action="/Home/SubmitLead" novalidate id="leadForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnTo" value="@returnTo" />
            <input type="hidden" name="formVisitId" id="formVisitId" />
            @if (!string.IsNullOrEmpty(teamSlug))
            {
                <input type="hidden" name="team" value="@teamSlug" />
            }
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="field-label">الاسم الكامل <span class="field-required">*</span></label>
                    <input name="FullName" id="fullName" type="text" class="form-control"
                           required maxlength="200" placeholder="مثال: محمد أحمد" />
                    <div class="field-error" data-for="fullName"></div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="field-label">رقم الهاتف <span class="field-required">*</span></label>
                    <input name="Phone" id="phone" type="tel" class="form-control"
                           required maxlength="30" inputmode="tel" placeholder="01xxxxxxxxx" />
                    <div class="field-error" data-for="phone"></div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="field-label">السن <span class="field-required">*</span></label>
                    <select name="Age" id="age" class="form-select" required>
                        <option value="" selected disabled>اختر السن</option>
                        @for (var a = HomeController.MinAge; a < HomeController.MaxAge; a++)
                        {
                            <option value="@a">@a</option>
                        }
                        <option value="@HomeController.MaxAge">@HomeController.MaxAge أو أكثر</option>
                    </select>
                    <div class="field-error" data-for="age"></div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="field-label">الوظيفة المطلوبة <span class="field-required">*</span></label>
                    <input name="InterestedJobTitle" id="jobTitle" type="text" class="form-control"
                           required maxlength="200" placeholder="مثال: سائق، فني كهرباء..." />
                    <div class="field-error" data-for="jobTitle"></div>
                </div>
                @* Notes stay folded so the form looks short *@
                <div class="col-12">
                    <button type="button" class="more-fields-toggle" id="moreFieldsToggle" aria-expanded="false" aria-controls="moreFields">
                        <i class="bi bi-plus-circle"></i> إضافة ملاحظات (اختياري)
                    </button>
                </div>
                <div class="col-12" id="moreFields" hidden>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="field-label">ملاحظات</label>
                            <textarea name="Notes" id="notesField" class="form-control"
                                      placeholder="أي معلومات إضافية تريد إضافتها..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="col-12" style="margin-top:4px">
                    <button type="submit" class="btn-submit btn-submit-wa" id="submitBtn">
                        <i class="bi bi-whatsapp"></i> كلمنا على الواتساب
                    </button>
                </div>
            </div>
        </form>

        <div class="form-note">
            <i class="bi bi-lock-fill"></i> بياناتك محمية — الاستشارة الأولى مجانية تماماً
        </div>
    </div>

</div><!-- /form-split -->

<script>
    /* ── Anonymous form analytics ("إحصائيات الفورم"): seen → fields touched → submitted.
          No names or numbers are sent — only which field, never what was typed. ── */
    (function () {
        var form = document.getElementById('leadForm');
        if (!form || !window.fetch) return;
        var page = '@(string.IsNullOrEmpty(teamSlug) ? (returnTo == "register" ? "register" : "home") : "team")';
        var team = '@(teamSlug ?? "")';

        // Same visit across the redirect back after an error (30 minutes)
        var key = 'fv:' + location.pathname, id = null;
        try {
            var saved = JSON.parse(sessionStorage.getItem(key) || 'null');
            if (saved && Date.now() - saved.t < 30 * 60 * 1000) id = saved.id;
        } catch (e) { }
        if (!id) id = (crypto.randomUUID ? crypto.randomUUID() : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 3 | 8)).toString(16);
        }));
        try { sessionStorage.setItem(key, JSON.stringify({ id: id, t: Date.now() })); } catch (e) { }
        document.getElementById('formVisitId').value = id;

        window.__formTrack = function (data) { send(data); };
        function send(data) {
            data.id = id;
            var body = JSON.stringify(data);
            if (navigator.sendBeacon && navigator.sendBeacon('/track/form', new Blob([body], { type: 'text/plain' }))) return;
            fetch('/track/form', { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }).catch(function () { });
        }

        // "Seen" only once the form is actually on screen (on the home page it's further down)
        var q = new URLSearchParams(location.search);
        var utm = q.get('utm_source') || (q.get('fbclid') ? 'facebook' : q.get('gclid') ? 'google' : q.get('ttclid') ? 'tiktok' : '');
        var viewData = { ev: 'view', page: page, team: team, ref: document.referrer || '', utmSource: utm, utmCampaign: q.get('utm_campaign') || '' };
        var seen = false;
        function markSeen() { if (!seen) { seen = true; send(viewData); } }
        if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (entries, obs) {
                if (entries.some(function (en) { return en.isIntersecting; })) { markSeen(); obs.disconnect(); }
            }, { threshold: 0.3 }).observe(form);
        } else markSeen();

        // Time on page + how far they scrolled — sent when they leave or switch apps
        var t0 = Date.now(), maxScroll = 0;
        function trackScroll() {
            var h = document.documentElement.scrollHeight - window.innerHeight;
            var pct = h > 0 ? Math.round(window.scrollY * 100 / h) : 100;
            if (pct > maxScroll) maxScroll = Math.min(100, pct);
        }
        window.addEventListener('scroll', trackScroll, { passive: true });
        trackScroll();
        function sendLeave() { if (seen) send({ ev: 'leave', secs: Math.round((Date.now() - t0) / 1000), scroll: maxScroll }); }
        document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') sendLeave(); });
        window.addEventListener('pagehide', sendLeave);

        var FIELD_KEYS = { FullName: 'name', Phone: 'phone', Age: 'age', InterestedJobTitle: 'job', Notes: 'notes' };
        var touched = {};
        form.addEventListener('focusin', function (e) {
            var k = FIELD_KEYS[e.target.name];
            if (!k || touched[k]) return;
            touched[k] = true;
            markSeen();
            send({ ev: 'field', field: k });
        });
    })();

    (function () {
        /* ── Optional fields toggle ── */
        var toggle = document.getElementById('moreFieldsToggle'), more = document.getElementById('moreFields');
        if (toggle && more) toggle.addEventListener('click', function () {
            more.hidden = !more.hidden;
            toggle.setAttribute('aria-expanded', String(!more.hidden));
            toggle.innerHTML = more.hidden ? '<i class="bi bi-plus-circle"></i> إضافة ملاحظات (اختياري)' : '<i class="bi bi-dash-circle"></i> إخفاء الملاحظات';
        });
    })();

    (function () {
        /* ── Required fields: the button does nothing until name, phone, age and job are valid ── */
        var leadForm  = document.getElementById('leadForm');
        var submitBtn = document.getElementById('submitBtn');
        if (!leadForm || !submitBtn) return;

        function digits(v) {
            return String(v || '').replace(/[٠-٩]/g, function (d) { return '٠١٢٣٤٥٦٧٨٩'.indexOf(d); })
                                  .replace(/[۰-۹]/g, function (d) { return '۰۱۲۳۴۵۶۷۸۹'.indexOf(d); })
                                  .replace(/\D/g, '');
        }
        var RULES = [
            ['fullName', function (v) { return v.trim().length >= 2; }, 'من فضلك اكتب اسمك'],
            ['phone', function (v) { var d = digits(v); return d.length >= 10 && d.length <= 15; }, 'اكتب رقم موبايل صحيح (مثال 01012345678)'],
            ['age', function (v) { return !!v; }, 'اختار السن'],
            ['jobTitle', function (v) { return v.trim().length >= 2; }, 'اكتب الوظيفة اللي عايزها']
        ];
        function check(id) {
            var rule = RULES.filter(function (r) { return r[0] === id; })[0];
            var el = document.getElementById(id), box = leadForm.querySelector('.field-error[data-for="' + id + '"]');
            var ok = rule[1](el.value);
            el.classList.toggle('is-invalid', !ok);
            if (box) box.textContent = ok ? '' : rule[2];
            return ok;
        }
        // Clear the message as soon as the field is fixed
        RULES.forEach(function (r) {
            var el = document.getElementById(r[0]);
            el.addEventListener(r[0] === 'age' ? 'change' : 'input', function () { if (el.classList.contains('is-invalid')) check(r[0]); });
        });

        leadForm.addEventListener('submit', function (e) {
            var firstBad = null;
            RULES.forEach(function (r) { if (!check(r[0]) && !firstBad) firstBad = r[0]; });
            if (firstBad) {
                e.preventDefault();
                var el = document.getElementById(firstBad);
                el.focus({ preventScroll: true });
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (window.__formTrack) window.__formTrack({ ev: 'verr', field: { fullName: 'name', phone: 'phone', age: 'age', jobTitle: 'job' }[firstBad] });
                return;
            }
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>جارٍ الإرسال...';
        });
    })();
</script>

<style>
    .more-fields-toggle { background: none; border: 0; color: #1E3055; font-weight: 700; font-size: 14px; padding: 2px 0; }
    .more-fields-toggle i { margin-inline-end: 4px; }
</style>
<style>
    .btn-submit.btn-submit-wa { background: #25D366; box-shadow: 0 4px 14px rgba(37,211,102,.35); font-size: 1.05rem; }
    .btn-submit.btn-submit-wa::after { display: none; }
    .btn-submit.btn-submit-wa:hover { background: #1ebe5b; box-shadow: 0 8px 24px rgba(37,211,102,.4); }
    .btn-submit.btn-submit-wa i { font-size: 1.35rem; }
    .field-error { color: #dc2626; font-size: 12.5px; font-weight: 600; margin-top: 4px; min-height: 0; }
    .field-error:empty { display: none; }
    #leadForm .form-control.is-invalid, #leadForm .form-select.is-invalid { border-color: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.12); background-image: none; }
</style>
