@{ ViewData["Title"] = "قناة المدير وأسئلة المساعد"; }
@Html.AntiForgeryToken()
<section class="container-fluid py-3" dir="rtl">
    <h1 class="h3">قناة المدير وأسئلة المساعد</h1>
    <p>قناة خاصة للتدريب والتوضيح. إجابة المدير لا تُرسل للعميل تلقائيًا؛ تُجهز مسودة للمراجعة.</p>
    <div class="d-flex gap-2 flex-wrap mb-3"><select id="admin-account" class="form-select w-auto" aria-label="حساب واتساب"></select><button id="admin-refresh" class="btn btn-outline-primary">تحديث</button><a href="/AiSalesTraining/Index" class="btn btn-outline-secondary">تدريب المحادثات</a></div>
    <div id="admin-status" class="alert alert-info" role="status"></div>
    <div id="admin-error" class="alert alert-danger d-none" role="alert"></div>
    <section class="card p-3 mb-3"><h2 class="h5">ربط رقم المدير</h2>
        <p>اربط رقمك بحساب المدير الحالي ثم أرسل رمز التوثيق من نفس الرقم إلى رقم الشركة. لا تستخدم رقمًا له محادثة عميل موجودة.</p>
        <form id="admin-bind" class="d-flex gap-2 flex-wrap"><input id="admin-phone" class="form-control w-auto" type="tel" dir="ltr" placeholder="+201012345678" aria-label="رقم المدير" required maxlength="20"><button class="btn btn-primary">ربط رقمي</button></form>
        <div id="admin-code-box" class="mt-2 mb-3" role="status" hidden>
            <p id="admin-code" class="mb-1"></p>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <code id="admin-code-value" dir="ltr" class="fs-5 user-select-all"></code>
                <button id="admin-code-copy" type="button" class="btn btn-sm btn-outline-primary">نسخ الرمز</button>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap"><button id="admin-renew" class="btn btn-outline-secondary">تجديد رمز التوثيق</button><button id="admin-pause" class="btn btn-outline-warning">إيقاف التدريب</button><button id="admin-resume" class="btn btn-outline-success">استئناف التدريب</button><button id="admin-pump" class="btn btn-outline-primary">معالجة رسائل المدير المعلقة</button></div>
    </section>
    <section class="card p-3 mb-3"><h2 class="h5">سؤال المدير عن محادثة عميل</h2>
        <form id="admin-ask" class="row g-2"><div class="col-12"><input id="admin-conversation" class="form-control" placeholder="معرف المحادثة" aria-label="معرف المحادثة" required></div><div class="col-12"><textarea id="admin-question" class="form-control" maxlength="1800" aria-label="السؤال" placeholder="اتركه فارغًا لاستخدام سؤال العميل بعد إخفاء بياناته"></textarea></div><div><button class="btn btn-primary">إضافة سؤال للمدير</button></div></form>
    </section>
    <section class="card p-3 mb-3"><h2 class="h5">طلبات التوضيح</h2><p class="text-muted">حدد نطاق كل إجابة. استثناء عميل واحد لا يتحول لسياسة عامة. المعلومة المنشورة تحتاج مراجعة صحتها وحداثتها؛ الأسعار والقرارات الرسمية تُراجع في مصدرها المعتمد.</p><div id="admin-requests"></div></section>
    <section class="card p-3"><h2 class="h5">سجل التدريب الخاص</h2><div id="admin-messages"></div></section>
</section>
@section Scripts { <script src="~/js/ai-admin-learning.js" asp-append-version="true"></script> }
