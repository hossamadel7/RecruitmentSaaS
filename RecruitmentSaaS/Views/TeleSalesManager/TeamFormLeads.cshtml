@using RecruitmentSaaS.Models.Entities
@model IEnumerable<Lead>
@{
    ViewData["Title"] = "ليدز فورم الفريق";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var formUrl = ViewBag.FormUrl as string;
    var myTeam = ViewBag.MyTeam as List<User> ?? new List<User>();
}

<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);">📝</div>
        <div>
            <h1 class="page-title">ليدز فورم الفريق</h1>
            <p style="color:var(--text-muted);font-size:.8rem;margin:2px 0 0;">
                @Model.Count().ToString("N0") ليد أقل من السن المحدد — ظاهرين ليك بس لحد ما تعيّنهم
            </p>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(formUrl))
{
    <div class="card mb-3">
        <div class="card-body d-flex align-items-center gap-2 flex-wrap">
            <span style="font-weight:700;font-size:.85rem">رابط فورم فريقك:</span>
            <input type="text" readonly class="form-control form-control-sm" id="teamFormUrl" dir="ltr"
                   value="@formUrl" style="max-width:380px" onclick="this.select()" />
            <button type="button" class="btn btn-primary btn-sm" id="copyFormUrl">
                <i class="bi bi-clipboard"></i> نسخ
            </button>
            <span style="font-size:.75rem;color:var(--text-muted)">
                اللي سنهم من السن المحدد أو أكبر بيتوزعوا بالدور على فريقك ويتحولوا لواتساب الفريق.
            </span>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state" style="padding:48px;">
                <div class="empty-state-icon">📭</div>
                <div class="empty-state-title">لا توجد ليدز جديدة من فورم الفريق</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>الكود</th>
                            <th>الاسم</th>
                            <th>الهاتف</th>
                            <th>السن</th>
                            <th>الوظيفة المطلوبة</th>
                            <th>ملاحظات</th>
                            <th>التاريخ</th>
                            <th>تعيين لـ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td style="font-family:monospace;font-size:.78rem;color:var(--text-muted);">@(lead.LeadCode ?? "—")</td>
                                <td style="font-weight:600;">@lead.FullName</td>
                                <td style="font-family:monospace;font-size:.83rem;" dir="ltr">@lead.Phone</td>
                                <td>@(lead.Age?.ToString() ?? "—")</td>
                                <td style="font-size:.82rem;">@(lead.InterestedJobTitle ?? "—")</td>
                                <td style="font-size:.78rem;color:var(--text-muted);max-width:220px;white-space:normal;">@(lead.Notes ?? "—")</td>
                                <td style="font-size:.78rem;color:var(--text-muted);">@lead.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (myTeam.Any())
                                    {
                                        <form asp-action="AssignTeamLead" method="post" class="d-flex gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="leadId" value="@lead.Id" />
                                            <select name="salesUserId" class="form-select form-select-sm" style="min-width:140px" required>
                                                <option value="" selected disabled>اختر</option>
                                                @foreach (var m in myTeam)
                                                {
                                                    <option value="@m.Id">@m.FullName</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-primary btn-sm" title="تعيين">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size:.75rem;color:var(--text-muted)">لا يوجد موظفين في فريقك</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById('copyFormUrl')?.addEventListener('click', function () {
        var input = document.getElementById('teamFormUrl');
        var btn = this;
        navigator.clipboard.writeText(input.value).then(function () {
            btn.innerHTML = '<i class="bi bi-check-lg"></i> تم النسخ';
            setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i> نسخ'; }, 1500);
        }, function () { input.select(); });
    });
</script>
