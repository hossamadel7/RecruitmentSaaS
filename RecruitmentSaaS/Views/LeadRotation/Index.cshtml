@using RecruitmentSaaS.Services
@model List<LeadDistributor.RotationSlot>
@{
    ViewData["Title"] = "توزيع الليدز";
    ViewData["Subtitle"] = "مين ياخد الليد الجاي، وكام ليد في كل دور";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string scope = ViewBag.Scope;
    string scopeTitle = ViewBag.ScopeTitle;
    bool isAdmin = ViewBag.IsAdmin;
    bool isTeam = ViewBag.IsTeam;
    short maxShare = ViewBag.MaxShare;
    var teams = ViewBag.Teams as List<(string Scope, string Name)> ?? new();
    var upcoming = ViewBag.Upcoming as List<string> ?? new();
    string? currentName = ViewBag.CurrentName;
    string? selectedCountry = ViewBag.Country;
    string? countryLabel = CountryRouting.DisplayName(selectedCountry);
    Guid? managerId = ViewBag.ManagerId;
    var rule = (RecruitmentSaaS.Models.Entities.CountryRoutingRule)ViewBag.CountryRule;
    int currentGiven = ViewBag.CurrentGiven;
    int currentShare = ViewBag.CurrentShare;
}

<style>
    .rr-wrap { padding: 24px; max-width: 900px; }
    .rr-toggle { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; }
    .rr-toggle-control { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .rr-toggle input { appearance: none; -webkit-appearance: none; direction: ltr; width: 54px; height: 32px; border: 2px solid #94a3b8; border-radius: 999px; background: #94a3b8; position: relative; cursor: pointer; margin: 0; transition: background .15s, border-color .15s; }
    .rr-toggle input::before { content: ""; position: absolute; width: 24px; height: 24px; left: 2px; top: 2px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px #0003; transition: transform .15s; }
    .rr-toggle input:checked { background: #16a34a; border-color: #16a34a; }
    .rr-toggle input:checked::before { transform: translateX(22px); }
    .rr-toggle input:focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
    .rr-toggle-state { font-weight: 700; font-size: 13px; min-width: 36px; }
    @@media (prefers-reduced-motion: reduce) { .rr-toggle input, .rr-toggle input::before { transition: none; } }
    .rr-countries { display: flex; gap: 8px; flex-wrap: wrap; }
    .rr-help { font-size: 12.5px; color: #64748B; line-height: 1.9; }
    .rr-row { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border, #e2e8f0); border-radius: 12px; background: #fff; margin-bottom: 8px; transition: opacity .15s; }
    .rr-row.paused { opacity: .55; background: #f8fafc; }
    .rr-pos { width: 28px; height: 28px; border-radius: 50%; background: #eef2ff; color: #4338ca; font-weight: 800; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .rr-name { flex: 1; font-weight: 600; font-size: 14px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rr-move { display: flex; flex-direction: column; gap: 2px; }
    .rr-move button { border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; width: 30px; height: 22px; line-height: 1; padding: 0; color: #475569; }
    .rr-move button:disabled { opacity: .3; }
    .rr-share { display: flex; align-items: center; gap: 4px; }
    .rr-share button { width: 32px; height: 32px; border-radius: 8px; border: 1px solid #e2e8f0; background: #fff; font-size: 18px; line-height: 1; padding: 0; }
    .rr-share input { width: 52px; text-align: center; font-weight: 800; font-size: 15px; }
    .rr-unit { font-size: 11.5px; color: #64748B; width: 58px; }
    .rr-chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .rr-chip { background: #eef2ff; color: #3730a3; border-radius: 99px; padding: 3px 10px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
    .rr-chip.next { background: #16a34a; color: #fff; }
    .rr-arrow { color: #94a3b8; font-size: 12px; }
    @@media (max-width: 576px) {
        .rr-wrap { padding: 14px; }
        .rr-unit { display: none; }
    }
</style>

<div class="rr-wrap">

    @if (isAdmin)
    {
        <div class="card mb-3"><div class="card-body p-3">
            <label class="fw-semibold" for="scopePicker">الفريق</label>
            <select id="scopePicker" class="form-select" onchange="location.href='/LeadRotation/Index?scope='+encodeURIComponent(this.value)+'&country='+encodeURIComponent('@selectedCountry')">
                <option value="@CountryRouting.Scope(selectedCountry ?? CountryRouting.Countries[0])" selected="@(!isTeam && selectedCountry != null)">إعلانات — كل التيلي سيلز</option>
                <option value="all" selected="@(scope == "all")">التوزيع العام</option>
                @foreach (var t in teams)
                {
                    <option value="@t.Scope" selected="@(managerId == LeadDistributor.ManagerOfScope(t.Scope))">فريق @t.Name</option>
                }
            </select>
        </div></div>
    }

    <nav class="rr-countries mb-3" aria-label="اختيار دولة الإعلان">
        @foreach (var country in CountryRouting.Countries)
        {
            var countryScope = managerId == null ? CountryRouting.Scope(country) : CountryRouting.TeamScope(managerId.Value, country);
            <a class="btn @(selectedCountry == country ? "btn-primary" : "btn-outline-primary")" aria-current="@(selectedCountry == country ? "page" : null)" href="/LeadRotation/Index?scope=@Uri.EscapeDataString(countryScope)">@CountryRouting.DisplayName(country)</a>
        }
    </nav>

    <div class="card mb-3">
        <div class="card-body p-4">
            <div style="font-weight:800;font-size:16px;margin-bottom:6px">@scopeTitle</div>
            <div class="rr-help">
                @if (selectedCountry != null)
                {
                    <span>اختار السن من كام لكام، وبعده حدد نصيب كل موظف من ليدز @countryLabel. الحصة 0 تعني إن الموظف مش بيستقبل ليدز للدولة دي.</span>
                }
                else
                {
                    <span>توزيع الليدز العامة على التيلي سيلز.</span>
                }
                <br />• رتّب الأسماء بالأسهم، وحدد كل واحد ياخد كام ليد ورا بعض قبل ما الدور ينتقل للي بعده.
                <br />• مثال: ٣ للأول، ٢ للتاني، ١ للتالت… وبعد آخر واحد الدورة ترجع من الأول.
                <br />• <strong>0 = موقوف</strong> (مثلاً في إجازة) — مش هياخد ليدز لحد ما ترجّع الرقم.
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card"><div class="card-body p-4 text-center" style="color:#64748B">
            @(isTeam ? "مفيش تيلي سيلز نشطين في الفريق ده." : "مفيش تيلي سيلز نشطين.")
        </div></div>
    }
    <div>
        <form asp-action="Save" method="post" id="rrForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="scope" value="@scope" />

            @if (selectedCountry != null)
            {
                <div class="card mb-3"><div class="card-body p-3">
                    <h2 class="h6">أعمار عملاء @countryLabel</h2>
                    <label class="rr-toggle mb-3" for="country-enabled">
                        <span>توزيع ليدز @countryLabel</span>
                        <span class="rr-toggle-control">
                            <span class="rr-toggle-state" id="country-toggle-state">@(rule.Enabled ? "ON" : "OFF")</span>
                            <input id="country-enabled" type="checkbox" role="switch" name="enabled" value="true" checked="@rule.Enabled" aria-describedby="country-enabled-status" data-saved-enabled="@(rule.Enabled ? "true" : "false")" />
                        </span>
                    </label>
                    <div id="country-enabled-status" class="alert @(rule.Enabled ? "alert-success" : "alert-secondary") py-2" role="status" aria-live="polite" aria-atomic="true">
                        <span id="country-saved-status">@(rule.Enabled ? $"توزيع ليدز {countryLabel} مفعّل الآن" : $"توزيع ليدز {countryLabel} متوقف حاليًا")</span>
                        @if (rule.Enabled && !Model.Any(r => r.Share > 0))
                        {
                            <span class="d-block small mt-1">حدد حصة لموظف واحد على الأقل واحفظ عشان يبدأ استقبال الليدز.</span>
                        }
                    </div>
                    <div id="country-enabled-pending" class="alert alert-warning py-2" role="status" aria-live="polite" aria-atomic="true" hidden></div>
                    <div class="row g-2">
                        <div class="col-6"><label for="minAge">من سن</label><input id="minAge" class="form-control" type="number" name="minAge" min="16" max="100" required value="@rule.MinAge" /></div>
                        <div class="col-6"><label for="maxAge">إلى سن</label><input id="maxAge" class="form-control" type="number" name="maxAge" min="16" max="100" required value="@rule.MaxAge" /></div>
                        <div class="col-12"><label for="fallbackCountry">لو السن خارج النطاق</label>
                            <select id="fallbackCountry" name="fallbackCountry" class="form-select">
                                <option value="">بدون تحويل لدولة أخرى</option>
                                @foreach (var country in CountryRouting.Countries.Where(c => c != selectedCountry))
                                {
                                    <option value="@country" selected="@(rule.FallbackCountry == country)">تحويل إلى @CountryRouting.DisplayName(country)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="rr-help mt-2 mb-0">التحويل يتطلب إن الدولة البديلة تكون مفعّلة والسن مناسب لها@(isTeam ? " داخل نفس الفريق" : ""). لو مفيش موظف متاح، العميل يفضل بدون تعيين.</p>
                </div></div>
            }
            <h2 class="h6">توزيع الليدز على الموظفين</h2>
            <div id="rrList">
                @foreach (var r in Model)
                {
                    <div class="rr-row @(r.Share == 0 ? "paused" : "")" data-name="@r.Name">
                        <div class="rr-pos"></div>
                        <div class="rr-move">
                            <button type="button" class="rr-up" title="لفوق"><i class="bi bi-chevron-up"></i></button>
                            <button type="button" class="rr-down" title="لتحت"><i class="bi bi-chevron-down"></i></button>
                        </div>
                        <div class="rr-name">@r.Name</div>
                        <input type="hidden" name="userIds" value="@r.UserId" />
                        <div class="rr-share">
                            <button type="button" class="rr-minus">−</button>
                            <input type="number" name="shares" class="form-control form-control-sm" min="0" max="@maxShare" value="@r.Share" inputmode="numeric" />
                            <button type="button" class="rr-plus">+</button>
                        </div>
                        <div class="rr-unit">ليد / دور</div>
                    </div>
                }
            </div>

            <div class="card mt-3">
                <div class="card-body p-3">
                    <div style="font-size:12.5px;color:#64748B;margin-bottom:8px">شكل الدورة الواحدة:</div>
                    <div class="rr-chips" id="rrCycle"></div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3 flex-wrap">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> حفظ</button>
            </div>
        </form>

        <div class="card mt-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div style="font-weight:700;font-size:15px">الدور دلوقتي</div>
                        <div style="font-size:13px;color:#64748B;margin-top:4px">
                            @if (currentName != null)
                            {
                                <span>آخر ليد راح لـ <strong>@currentName</strong> (@currentGiven من @currentShare في الدور ده)</span>
                            }
                            else
                            {
                                <span>الدورة لسه هتبدأ من أول واحد في القائمة.</span>
                            }
                        </div>
                    </div>
                    <form asp-action="Restart" method="post" onsubmit="return confirm('الليد الجاي هيروح لأول واحد في القائمة. متأكد؟')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scope" value="@scope" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise me-1"></i> ابدأ الدورة من الأول</button>
                    </form>
                </div>
                @if (upcoming.Any())
                {
                    <div style="font-size:12.5px;color:#64748B;margin:14px 0 8px">الليدز الجاية هتروح لـ (حسب الإعدادات المحفوظة):</div>
                    <div class="rr-chips">
                        @for (var i = 0; i < upcoming.Count; i++)
                        {
                            if (i > 0) { <span class="rr-arrow"><i class="bi bi-arrow-left"></i></span> }
                            <span class="rr-chip @(i == 0 ? "next" : "")">@(i + 1). @upcoming[i]</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var toggle = document.getElementById('country-enabled');
        if (toggle) {
            var saved = toggle.dataset.savedEnabled === 'true';
            var pending = document.getElementById('country-enabled-pending');
            toggle.addEventListener('change', function () {
                document.getElementById('country-toggle-state').textContent = toggle.checked ? 'ON' : 'OFF';
                pending.hidden = toggle.checked === saved;
                pending.textContent = toggle.checked
                    ? 'اضغط حفظ لتفعيل التوزيع — التغيير لسه ما اتحفظش.'
                    : 'اضغط حفظ لإيقاف التوزيع — التغيير لسه ما اتحفظش.';
            });
        }
        var list = document.getElementById('rrList');
        if (!list) return;
        var max = @maxShare;

        function rows() { return Array.prototype.slice.call(list.querySelectorAll('.rr-row')); }

        function refresh() {
            var all = rows(), cycle = document.getElementById('rrCycle'), html = [];
            all.forEach(function (row, i) {
                row.querySelector('.rr-pos').textContent = i + 1;
                row.querySelector('.rr-up').disabled = i === 0;
                row.querySelector('.rr-down').disabled = i === all.length - 1;
                var n = parseInt(row.querySelector('input[name=shares]').value, 10) || 0;
                row.classList.toggle('paused', n === 0);
                if (n > 0) html.push('<span class="rr-chip">' + row.dataset.name.replace(/</g, '&lt;') + ' × ' + n + '</span>');
            });
            cycle.innerHTML = html.length
                ? html.join('<span class="rr-arrow"><i class="bi bi-arrow-left"></i></span>') + '<span class="rr-arrow"><i class="bi bi-arrow-repeat"></i> وترجع من الأول</span>'
                : '@(selectedCountry != null ? Html.Raw("<span style=\"color:#64748B;font-size:13px\">الكل 0 — عملاء الدولة دي هيفضلوا بدون تعيين</span>") : Html.Raw("<span style=\"color:#dc2626;font-size:13px\">الكل موقوف — لازم شخص واحد على الأقل ياخد ليدز</span>"))';
        }

        list.addEventListener('click', function (e) {
            var btn = e.target.closest('button');
            if (!btn) return;
            var row = btn.closest('.rr-row'), input = row.querySelector('input[name=shares]');
            if (btn.classList.contains('rr-up') && row.previousElementSibling) list.insertBefore(row, row.previousElementSibling);
            else if (btn.classList.contains('rr-down') && row.nextElementSibling) list.insertBefore(row.nextElementSibling, row);
            else if (btn.classList.contains('rr-plus')) input.value = Math.min(max, (parseInt(input.value, 10) || 0) + 1);
            else if (btn.classList.contains('rr-minus')) input.value = Math.max(0, (parseInt(input.value, 10) || 0) - 1);
            refresh();
        });
        list.addEventListener('input', refresh);
        refresh();
    })();
</script>
