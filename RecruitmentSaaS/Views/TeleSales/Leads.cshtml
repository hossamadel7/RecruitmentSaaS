@model List<RecruitmentSaaS.Models.DTOs.LeadListItemDto>
@{
    ViewData["Title"] = "عملائي";
    var currentStatus = ViewBag.CurrentStatus as byte?;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    int? minAge = ViewBag.MinAge as int?;
    int? maxAge = ViewBag.MaxAge as int?;
    bool needCall = ViewBag.NeedCall == true;
    int needCallCount = ViewBag.NeedCallCount ?? 0;
    // Keep the age range when switching status / page
    string Link(byte? st, int? p = null, bool? call = null)
    {
        var parts = new List<string>();
        if (call ?? needCall) parts.Add("needCall=true");
        if (st.HasValue) parts.Add("status=" + st.Value);
        if (minAge.HasValue) parts.Add("minAge=" + minAge.Value);
        if (maxAge.HasValue) parts.Add("maxAge=" + maxAge.Value);
        if (p.HasValue && p.Value > 1) parts.Add("page=" + p.Value);
        return "/TeleSales/Leads" + (parts.Count == 0 ? "" : "?" + string.Join("&", parts));
    }
}

<div class="page-header">
    <div>
        <h1 class="page-header-title">عملائي</h1>
        <div class="page-header-sub">@totalCount عميل مسجل</div>
    </div>
</div>

<!-- Status Filter -->
<div class="card mb-3">
    <div class="card-body py-3">
        <div class="filter-bar">
            <a href="@Link(null, call: false)" class="filter-btn @(currentStatus == null && !needCall ? "active" : "")">الكل</a>
            <a href="@Link(1)" class="filter-btn @(currentStatus == 1 ? "active" : "")">جديد</a>
            <a href="@Link(2)" class="filter-btn @(currentStatus == 2 ? "active" : "")">تم التواصل</a>
            <a href="@Link(3)" class="filter-btn @(currentStatus == 3 ? "active" : "")">استجاب</a>
            <a href="@Link(4)" class="filter-btn @(currentStatus == 4 ? "active" : "")">مهتم</a>
            <a href="@Link(5)" class="filter-btn @(currentStatus == 5 ? "active" : "")">موعد مجدول</a>
            <a href="@Link(8)" class="filter-btn @(currentStatus == 8 ? "active" : "")">خسارة</a>
            @if (needCallCount > 0 || needCall)
            {
                <a href="@Link(null, call: !needCall)" class="filter-btn need-call-chip @(needCall ? "active" : "")"
                   title="عملاء رقمهم مش على واتساب — لازم تكلمهم تليفون">
                    <i class="bi bi-telephone-fill"></i> محتاج اتصال <span class="need-call-count">@needCallCount</span>
                </a>
            }
        </div>
        <form method="get" action="/TeleSales/Leads" class="d-flex flex-wrap align-items-end gap-2 mt-3">
            @if (currentStatus.HasValue) { <input type="hidden" name="status" value="@currentStatus" /> }
            <div style="width:110px">
                <label class="form-label form-label-sm mb-1">من سن</label>
                <input type="number" name="minAge" value="@minAge" min="18" max="65" class="form-control form-control-sm" placeholder="18" inputmode="numeric" />
            </div>
            <div style="width:110px">
                <label class="form-label form-label-sm mb-1">إلى سن</label>
                <input type="number" name="maxAge" value="@maxAge" min="18" max="65" class="form-control form-control-sm" placeholder="65" inputmode="numeric" />
            </div>
            <button type="submit" class="btn btn-primary btn-sm">تطبيق</button>
            @if (minAge.HasValue || maxAge.HasValue)
            {
                <a href="/TeleSales/Leads@(currentStatus.HasValue ? "?status=" + currentStatus : "")" class="btn btn-outline-secondary btn-sm">مسح السن</a>
            }
        </form>
    </div>
</div>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>لا يوجد عملاء معيّنين لك حالياً</p>
        </div>
    }
    else
    {
        <div style="overflow-x:auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>الكود</th>
                        <th>الاسم</th>
                        <th>الهاتف</th>
                        <th>السن</th>
                        <th>الحالة</th>
                        <th>آخر تواصل</th>
                        <th>تاريخ الإضافة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model)
                    {
                        var (stClass, stName) = lead.Status switch {
                            1 => ("badge-status-1", "جديد"),
                            2 => ("badge-status-2", "تم التواصل"),
                            3 => ("badge-status-3", "استجاب"),
                            4 => ("badge-status-4", "مهتم"),
                            5 => ("badge-status-5", "موعد مجدول"),
                            6 => ("badge-status-6", "زار المكتب"),
                            7 => ("badge-status-7", "تم التحويل"),
                            8 => ("badge-status-8", "خسارة"),
                            _ => ("badge-status-1", "غير معروف")
                        };
                        <tr>
                            <td>
                                <span style="font-size:11px;font-weight:700;color:var(--text-muted);background:#F1F5F9;padding:3px 8px;border-radius:6px">
                                    @lead.LeadCode
                                </span>
                            </td>
                            <td style="font-weight:600">
                                @lead.FullName
                                @if (lead.NotOnWhatsApp)
                                {
                                    <div class="no-wa-badge"><i class="bi bi-exclamation-triangle-fill"></i> مش على واتساب — كلّمه تليفون</div>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:13px;direction:ltr;text-align:right">@lead.Phone</td>
                            <td>@(lead.Age?.ToString() ?? "—")</td>
                            <td><span class="badge @stClass">@stName</span></td>
                            <td style="color:var(--text-muted);font-size:12.5px">
                                @(lead.LastContactedAt.HasValue ? lead.LastContactedAt.Value.ToString("dd/MM/yyyy") : "—")
                            </td>
                            <td style="color:var(--text-muted);font-size:12.5px">@lead.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (lead.NotOnWhatsApp)
                                {
                                    <a href="tel:@lead.Phone" class="call-btn" title="اتصال بالعميل">
                                        <i class="bi bi-telephone-fill"></i> اتصال
                                    </a>
                                }
                                else if (lead.ConversationId.HasValue)
                                {
                                    <a href="/Inbox/Index?c=@lead.ConversationId" title="فتح محادثة الواتساب"
                                       style="font-size:14px;color:#16a34a;text-decoration:none;padding:4px 10px;border:1px solid #86efac;border-radius:6px;margin-inline-end:4px">
                                        <i class="bi bi-whatsapp"></i>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="start-chat-btn" data-lead-id="@lead.Id" title="بدء محادثة واتساب (هيتبعت للعميل رسالة البداية المعتمدة)">
                                        <i class="bi bi-whatsapp"></i> بدء محادثة
                                    </button>
                                }
                                <a href="/TeleSales/LeadDetail/@lead.Id"
                                   style="font-size:12px;font-weight:600;color:var(--primary);text-decoration:none;padding:5px 12px;border:1px solid var(--primary);border-radius:6px">
                                    <i class="bi bi-eye"></i> تفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalCount > 20)
        {
            <div class="d-flex justify-content-center gap-2 p-3">
                @if (currentPage > 1)
                {
                    <a href="@Link(currentStatus, currentPage - 1)"
                       class="btn btn-sm" style="border:1px solid var(--border)">السابق</a>
                }
                <span class="btn btn-sm btn-primary">@currentPage</span>
                @if (Model.Count == 20)
                {
                    <a href="@Link(currentStatus, currentPage + 1)"
                       class="btn btn-sm" style="border:1px solid var(--border)">التالي</a>
                }
            </div>
        }
    }
</div>

<style>
    .no-wa-badge { font-size: 11.5px; font-weight: 700; color: #b91c1c; margin-top: 3px; }
    .call-btn { font-size: 12px; font-weight: 700; color: #fff; background: #dc2626; border: 1px solid #dc2626; border-radius: 6px; padding: 5px 10px; margin-inline-end: 4px; text-decoration: none; display: inline-block; }
    .call-btn:hover { background: #b91c1c; color: #fff; }
    .need-call-chip { color: #b91c1c !important; border-color: #fecaca !important; }
    .need-call-chip.active { background: #dc2626 !important; color: #fff !important; border-color: #dc2626 !important; }
    .need-call-count { background: #dc2626; color: #fff; border-radius: 99px; padding: 0 7px; font-size: 11px; margin-inline-start: 3px; }
    .need-call-chip.active .need-call-count { background: #fff; color: #dc2626; }
    .start-chat-btn { font-size: 12px; font-weight: 600; color: #15803d; background: #f0fdf4; border: 1px solid #86efac; border-radius: 6px; padding: 5px 10px; margin-inline-end: 4px; cursor: pointer; }
    .start-chat-btn:hover { background: #dcfce7; }
    .start-chat-btn:disabled { opacity: .6; cursor: wait; }
    .start-chat-error { display: block; color: #b91c1c; font-size: 11.5px; margin-top: 4px; }
</style>
<script>
    // Sends the approved opening message (if needed) and opens the chat in the WhatsApp section
    document.addEventListener('click', async function (e) {
        var btn = e.target.closest('.start-chat-btn');
        if (!btn || btn.disabled) return;
        var cell = btn.parentElement, old = cell.querySelector('.start-chat-error');
        if (old) old.remove();
        btn.disabled = true;
        var label = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جارٍ الإرسال...';
        try {
            var res = await fetch('/api/conversations/start-for-lead/' + btn.dataset.leadId, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
            var data = {};
            try { data = await res.json(); } catch (x) { }
            if (res.ok) { location.href = '/Inbox/Index?c=' + data.conversationId; return; }
            var err = document.createElement('span');
            err.className = 'start-chat-error';
            err.textContent = data.error || 'تعذر بدء المحادثة';
            cell.appendChild(err);
        } catch (x) {
            var err2 = document.createElement('span');
            err2.className = 'start-chat-error';
            err2.textContent = 'تعذر الاتصال — حاول تاني';
            cell.appendChild(err2);
        }
        btn.disabled = false;
        btn.innerHTML = label;
    });
</script>
