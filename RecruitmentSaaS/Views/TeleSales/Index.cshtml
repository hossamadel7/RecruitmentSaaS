@model RecruitmentSaaS.Models.DTOs.SalesDashboardDto
@{
    ViewData["Title"] = "لوحة تيلي سيلز";
    ViewData["Subtitle"] = "مرحباً، هنا ملخص نشاطك اليوم";
    int bookedToday = ViewBag.BookedToday;
    int bookedMonth = ViewBag.BookedMonth;
    int cameMonth = ViewBag.CameMonth;
    DateTime egyptToday = ViewBag.EgyptToday;
    var followUps = ViewBag.ChatFollowUps as List<RecruitmentSaaS.Controllers.TeleSalesController.ChatFollowUpItem> ?? new();
    var appointments = ViewBag.Appointments as List<RecruitmentSaaS.Controllers.TeleSalesController.OfficeAppointmentItem> ?? new();
    var myBookings = ViewBag.MyBookings as List<RecruitmentSaaS.Controllers.TeleSalesController.MyBookingItem> ?? new();
    string Iso(DateTime d) => d.ToString("yyyy-MM-dd");
    var ar = new System.Globalization.CultureInfo("ar-EG");
}

<style>
    .ts-row { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid #F1F5F9; }
    .ts-icon { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .ts-name { font-size: 13.5px; font-weight: 600; }
    .ts-sub { font-size: 12px; color: var(--text-muted); }
    @@media (max-width: 576px) { .ts-row { flex-wrap: wrap; } }
    .day-filter { display: flex; gap: 6px; padding: 10px 16px; border-bottom: 1px solid #F1F5F9; overflow-x: auto; scrollbar-width: none; align-items: center; }
    .day-filter::-webkit-scrollbar { display: none; }
    .day-chip { flex-shrink: 0; border: 1px solid var(--border); background: #fff; border-radius: 99px; padding: 4px 12px; font-size: 12.5px; font-weight: 600; color: #475569; white-space: nowrap; }
    .day-chip.active { background: #2563EB; border-color: #2563EB; color: #fff; }
    .day-pick { width: auto; min-width: 130px; flex-shrink: 0; }
    .day-empty { padding: 18px; text-align: center; color: var(--text-muted); font-size: 13px; }
    .day-count { margin-inline-start: auto; font-size: 12px; color: var(--text-muted); font-weight: 600; }
</style>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card blue">
            <div class="stat-icon"><i class="bi bi-building-check"></i></div>
            <div class="stat-value">@bookedToday</div>
            <div class="stat-label">حجوزاتي النهارده</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card green">
            <div class="stat-icon"><i class="bi bi-person-check-fill"></i></div>
            <div class="stat-value">@bookedMonth</div>
            <div class="stat-label">حجوزات الشهر — حضر منهم @cameMonth</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card amber">
            <div class="stat-icon"><i class="bi bi-calendar-event"></i></div>
            <div class="stat-value">@(followUps.Count + Model.TodayReminders.Count)</div>
            <div class="stat-label">متابعات النهارده</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card red">
            <div class="stat-icon"><i class="bi bi-person-lines-fill"></i></div>
            <div class="stat-value">@Model.MyLeadsTotal</div>
            <div class="stat-label">إجمالي عملائي</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">

    <!-- Today's follow-ups: from chats (متابعة) and lead reminders -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <div class="header-icon" style="background:#FFFBEB;color:#D97706">
                    <i class="bi bi-calendar-event"></i>
                </div>
                متابعات النهارده
                @if (followUps.Count + Model.TodayReminders.Count > 0)
                {
                    <span class="badge ms-auto" style="background:#D97706;color:#fff">@(followUps.Count + Model.TodayReminders.Count)</span>
                }
            </div>
            @if (!followUps.Any() && !Model.TodayReminders.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-check2-circle"></i>
                    <p>مفيش متابعات النهارده</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    @foreach (var f in followUps)
                    {
                        <div class="ts-row">
                            <div class="ts-icon" style="background:@(f.Overdue ? "#FEF2F2" : "#FFFBEB");color:@(f.Overdue ? "#DC2626" : "#D97706")"><i class="bi bi-whatsapp"></i></div>
                            <div style="flex:1;min-width:0">
                                <div class="ts-name">@f.Name</div>
                                <div class="ts-sub">
                                    @if (f.Overdue) { <span style="color:#DC2626;font-weight:700">متأخرة ·</span> }
                                    @(f.DueLocal.Date == egyptToday ? "النهارده" : f.DueLocal.ToString("dddd d/M", ar)) الساعة @f.DueLocal.ToString("h:mm tt", ar)
                                    @if (!string.IsNullOrWhiteSpace(f.Notes)) { <span>— @f.Notes</span> }
                                </div>
                            </div>
                            <div class="d-flex gap-1">
                                <a href="/Inbox/Index?c=@f.ConversationId" class="btn btn-sm btn-success"><i class="bi bi-whatsapp"></i> افتح</a>
                                <form asp-action="CompleteChatFollowUp" asp-controller="TeleSales" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit" class="btn btn-sm" style="border:1px solid var(--border);background:#fff">تم</button>
                                </form>
                            </div>
                        </div>
                    }
                    @foreach (var r in Model.TodayReminders)
                    {
                        <div class="ts-row">
                            <div class="ts-icon" style="background:#FEF2F2;color:#DC2626"><i class="bi bi-alarm"></i></div>
                            <div style="flex:1;min-width:0">
                                <div class="ts-name">@r.LeadName</div>
                                <div class="ts-sub">@r.LeadPhone — @r.Notes</div>
                            </div>
                            <div class="d-flex gap-1">
                                <a href="/TeleSales/LeadDetail/@r.LeadId" class="btn btn-sm btn-primary">عرض</a>
                                <form asp-action="DismissReminder" asp-controller="TeleSales" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reminderId" value="@r.Id" />
                                    <input type="hidden" name="leadId" value="@r.LeadId" />
                                    <button type="submit" class="btn btn-sm" style="border:1px solid var(--border);background:#fff">تجاهل</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Office appointments (حجز) -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <div class="header-icon" style="background:#EFF6FF;color:#2563EB">
                    <i class="bi bi-building-check"></i>
                </div>
                مواعيد المكتب
                <span class="day-count" id="appt-count"></span>
            </div>
            <div class="day-filter" data-target="appt">
                <button type="button" class="day-chip active" data-day="today">النهارده</button>
                <button type="button" class="day-chip" data-day="tomorrow">بكره</button>
                <button type="button" class="day-chip" data-day="after">بعد بكره</button>
                <button type="button" class="day-chip" data-day="week">الأسبوع ده</button>
                <button type="button" class="day-chip" data-day="late">فات ميعاده</button>
                <button type="button" class="day-chip" data-day="all">الكل</button>
                <input type="date" class="form-control form-control-sm day-pick" title="اختار يوم" />
            </div>
            @if (!appointments.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-calendar2-check"></i>
                    <p>مفيش حجوزات جاية — اعمل حجز من المحادثة</p>
                </div>
            }
            else
            {
                <div class="card-body p-0">
                    @foreach (var a in appointments)
                    {
                        var late = a.At.Date < egyptToday;
                        var isToday = a.At.Date == egyptToday;
                        <div class="ts-row" data-appt="@Iso(a.At.Date)">
                            <div class="ts-icon" style="background:@(late ? "#FEF2F2" : "#EFF6FF");color:@(late ? "#DC2626" : "#2563EB")"><i class="bi bi-building"></i></div>
                            <div style="flex:1;min-width:0">
                                <div class="ts-name">@a.Name</div>
                                <div class="ts-sub">
                                    @(isToday ? "النهارده" : a.At.ToString("dddd d/M", ar)) الساعة @a.At.ToString("h:mm tt", ar)
                                    @if (late) { <span class="badge" style="background:#FEE2E2;color:#B91C1C">ميعاده عدّى ومجاش</span> }
                                    else if (isToday) { <span class="badge" style="background:#DBEAFE;color:#1D4ED8">النهارده</span> }
                                </div>
                            </div>
                            @if (a.ConversationId != null)
                            {
                                <a href="/Inbox/Index?c=@a.ConversationId" class="btn btn-sm btn-success"><i class="bi bi-whatsapp"></i> افتح</a>
                            }
                            else
                            {
                                <a href="/TeleSales/LeadDetail/@a.LeadId" class="btn btn-sm btn-primary">عرض</a>
                            }
                        </div>
                    }
                    <div class="day-empty" id="appt-empty" hidden>مفيش مواعيد في اليوم ده</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- حجوزاتي: bookings I made, by the day I made them -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="header-icon" style="background:#F0FDF4;color:#16A34A">
                    <i class="bi bi-calendar-check"></i>
                </div>
                حجوزاتي
                <span class="day-count" id="bk-count"></span>
            </div>
            <div class="day-filter" data-target="bk">
                <button type="button" class="day-chip active" data-day="today">النهارده</button>
                <button type="button" class="day-chip" data-day="yesterday">امبارح</button>
                <button type="button" class="day-chip" data-day="week">آخر 7 أيام</button>
                <button type="button" class="day-chip" data-day="all">آخر 30 يوم</button>
                <input type="date" class="form-control form-control-sm day-pick" title="اختار يوم" />
            </div>
            <div class="card-body p-0">
                @foreach (var b in myBookings)
                {
                    var came = b.Status == 6 || b.Status == 7;
                    <div class="ts-row" data-bk="@Iso(b.BookedOn.Date)">
                        <div class="ts-icon" style="background:@(came ? "#F0FDF4" : "#EFF6FF");color:@(came ? "#16A34A" : "#2563EB")"><i class="bi @(came ? "bi-person-check-fill" : "bi-building-check")"></i></div>
                        <div style="flex:1;min-width:0">
                            <div class="ts-name">@b.Name</div>
                            <div class="ts-sub">
                                اتحجز @(b.BookedOn.Date == egyptToday ? "النهارده" : b.BookedOn.ToString("dddd d/M", ar))
                                @if (b.At != null) { <span>· الميعاد @b.At.Value.ToString("dddd d/M", ar) الساعة @b.At.Value.ToString("h:mm tt", ar)</span> }
                                @if (came) { <span class="badge" style="background:#DCFCE7;color:#15803D">حضر</span> }
                                else if (b.Status == 8) { <span class="badge" style="background:#FEE2E2;color:#B91C1C">خسارة</span> }
                            </div>
                        </div>
                        @if (b.ConversationId != null)
                        {
                            <a href="/Inbox/Index?c=@b.ConversationId" class="btn btn-sm btn-success"><i class="bi bi-whatsapp"></i> افتح</a>
                        }
                        else
                        {
                            <a href="/TeleSales/LeadDetail/@b.LeadId" class="btn btn-sm btn-primary">عرض</a>
                        }
                    </div>
                }
                <div class="day-empty" id="bk-empty" hidden>مفيش حجوزات في الفترة دي</div>
            </div>
        </div>
    </div>
</div>

<script>
    // Day filters for مواعيد المكتب and حجوزاتي (Egypt dates come from the server as yyyy-MM-dd)
    (function () {
        var today = '@Iso(egyptToday)';
        function addDays(iso, n) { var d = new Date(iso + 'T00:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }
        function matches(day, key, picked) {
            if (picked) return day === picked;
            switch (key) {
                case 'today': return day === today;
                case 'tomorrow': return day === addDays(today, 1);
                case 'after': return day === addDays(today, 2);
                case 'yesterday': return day === addDays(today, -1);
                case 'week': return key && (day >= addDays(today, -6) && day <= today);
                case 'late': return day < today;
                default: return true;
            }
        }
        function apply(bar, key, picked) {
            var target = bar.dataset.target, shown = 0;
            document.querySelectorAll('[data-' + target + ']').forEach(function (row) {
                var day = row.getAttribute('data-' + target);
                var ok = target === 'appt' && key === 'week' && !picked
                    ? day >= today && day <= addDays(today, 6)       // appointments: the coming 7 days
                    : matches(day, key, picked);
                row.style.display = ok ? '' : 'none';
                if (ok) shown++;
            });
            var empty = document.getElementById(target + '-empty');
            if (empty) empty.hidden = shown > 0;
            var count = document.getElementById(target + '-count');
            if (count) count.textContent = shown + (target === 'bk' ? ' حجز' : ' ميعاد');
        }
        document.querySelectorAll('.day-filter').forEach(function (bar) {
            var pick = bar.querySelector('.day-pick');
            bar.querySelectorAll('.day-chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    bar.querySelectorAll('.day-chip').forEach(function (c) { c.classList.toggle('active', c === chip); });
                    pick.value = '';
                    apply(bar, chip.dataset.day, null);
                });
            });
            pick.addEventListener('change', function () {
                bar.querySelectorAll('.day-chip').forEach(function (c) { c.classList.remove('active'); });
                apply(bar, null, pick.value || null);
            });
            apply(bar, 'today', null);
        });
    })();
</script>

<div class="row g-3">
    <!-- Recent Leads -->
    <div class="col-12">
        <div class="card h-100">
            <div class="card-header">
                <div class="header-icon" style="background:#EEF2FF;color:var(--primary)">
                    <i class="bi bi-person-lines-fill"></i>
                </div>
                آخر عملائي
                <a href="/TeleSales/Leads" class="btn btn-sm btn-primary ms-auto">عرض الكل</a>
            </div>
            @if (!Model.RecentLeads.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>لا يوجد عملاء معيّنين لك بعد</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>الكود</th>
                                <th>الاسم</th>
                                <th>الحالة</th>
                                <th>آخر تواصل</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lead in Model.RecentLeads)
                            {
                                var (stClass, stName) = lead.Status switch {
                                    1 => ("badge-status-1", "جديد"),
                                    2 => ("badge-status-2", "تم التواصل"),
                                    3 => ("badge-status-3", "استجاب"),
                                    4 => ("badge-status-4", "مهتم"),
                                    5 => ("badge-status-5", "موعد مجدول"),
                                    6 => ("badge-status-6", "زار المكتب"),
                                    7 => ("badge-status-7", "تم التحويل"),
                                    8 => ("badge-status-8", "خسارة"),
                                    _ => ("badge-status-1", "غير معروف")
                                };
                                <tr>
                                    <td>
                                        <span style="font-size:11px;font-weight:700;color:var(--text-muted);background:#F1F5F9;padding:3px 8px;border-radius:6px">
                                            @lead.LeadCode
                                        </span>
                                    </td>
                                    <td style="font-weight:600">@lead.FullName</td>
                                    <td><span class="badge @stClass">@stName</span></td>
                                    <td style="color:var(--text-muted);font-size:12.5px">
                                        @(lead.LastContactedAt.HasValue ? lead.LastContactedAt.Value.ToString("dd/MM/yyyy") : "—")
                                    </td>
                                    <td>
                                        <a href="/TeleSales/LeadDetail/@lead.Id"
                                           style="font-size:12px;font-weight:600;color:var(--primary);text-decoration:none;padding:5px 12px;border:1px solid var(--primary);border-radius:6px">
                                            <i class="bi bi-eye"></i> تفاصيل
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
